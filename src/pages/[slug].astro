---
/**
 * [slug].astro — Portafolio dinámico por perfil con Stack Tecnológico y WhatsApp.
 * Rutas generadas: /benjie, /nahomi, etc.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProfiles, getPortfolioBySlug } from '../lib/supabase';
import type { FullPortfolio } from '../lib/types';

export async function getStaticPaths() {
  const profiles = await getAllProfiles();
  return profiles.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const portfolioData = await getPortfolioBySlug(slug as string);

if (!portfolioData) {
  return Astro.redirect('/404');
}

const { profile, experiences, projects, services, skillCategories } = portfolioData;
const pageTitle = `${profile.full_name} — ${profile.headline}`;

const isBenjie = profile.slug === 'benjie';
const whatsappPhone = profile.phone || '593900000000';
const whatsappCleanNumber = whatsappPhone.replace(/[^0-9]/g, '');
const whatsappDefaultMsg = isBenjie
  ? 'Hola Benjie, vi tu portafolio y me gustaría cotizar un proyecto de TI.'
  : 'Hola Nahomi, vi tu portafolio y me gustaría cotizar un proyecto creativo.';
const whatsappUrl = `https://wa.me/${whatsappCleanNumber}?text=${encodeURIComponent(whatsappDefaultMsg)}`;

const rawCategories = projects.map((p) => p.category?.trim()).filter(Boolean) as string[];
const projectCategories = rawCategories.length > 0 ? ['Todos', ...Array.from(new Set(rawCategories))] : [];
---

<BaseLayout title={pageTitle} description={profile.bio} hideHeader={true} hideFooter={true}>
  <main class={`portfolio-page template-${profile.template_id || 'tech-minimal'} mode-${profile.theme_mode || 'dark'}`} style={`--profile-accent: ${profile.theme_accent || '#2563eb'};`}>
    
    <!-- BARRA SUPERIOR DE NAVEGACIÓN -->
    <nav class="top-nav" aria-label="Navegación del perfil">
      <div class="container top-nav__inner">
        <a href="/" class="top-nav__back" title="Volver al Portal Folio">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span class="portal-brand-tag">Folio</span>
        </a>
      </div>
    </nav>

    <!-- HERO SECTION -->
    <header class="hero-section">
      <div class="container hero-section__inner">
        <div class="hero-avatar">
          {profile.avatar_url ? (
            <img src={profile.avatar_url} alt={profile.full_name} class="hero-avatar-img" />
          ) : (
            <span>{profile.slug === 'benjie' ? 'BG' : (profile.slug === 'nahomi' ? 'NM' : profile.full_name.slice(0, 2).toUpperCase())}</span>
          )}
        </div>

        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>{profile.hero_badge || 'Disponible para proyectos'}</span>
        </div>

        <h1 class="hero-title">{profile.full_name}</h1>
        <p class="hero-headline">{profile.headline}</p>
        <p class="hero-bio">{profile.bio}</p>

        <div class="hero-cta-group">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>Conversar por WhatsApp</span>
          </a>

          {profile.email && (
            <a href={`mailto:${profile.email}`} class="btn btn--secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <span>Enviar Correo</span>
            </a>
          )}
        </div>

        {profile.location && (
          <div class="hero-meta">
            <span class="location-tag">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              {profile.location}
            </span>
          </div>
        )}
      </div>
    </header>

    <!-- STACK TECNOLÓGICO / HABILIDADES CLAVE -->
    {skillCategories && skillCategories.length > 0 && (
      <section class="section skills-section">
        <div class="container">
          <div class="section-header">
            <p class="section-tag">{isBenjie ? 'Arsenal Técnico' : 'Habilidades Creativas'}</p>
            <h2 class="section-title">{isBenjie ? 'Stack Tecnológico & Competencias' : 'Especialidades & Herramientas'}</h2>
          </div>
          <div class="skills-grid">
            {skillCategories.map((cat) => (
              <div class="skill-category-card">
                <h3 class="skill-category-title">{cat.title}</h3>
                <div class="skill-pills">
                  {cat.skills.map((s) => (
                    <span class="skill-pill">{s}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- PROYECTOS DESTACADOS -->
    {projects.length > 0 && (
      <section id="proyectos" class="section projects-section">
        <div class="container">
          <div class="section-header">
            <p class="section-tag">Portafolio</p>
            <h2 class="section-title">Trabajos y Proyectos Destacados</h2>
          </div>

          <!-- FILTRO POR CATEGORÍAS -->
          {projectCategories.length > 2 && (
            <div class="project-filter-bar" id="project-filters">
              {projectCategories.map((cat, idx) => (
                <button class={`filter-pill ${idx === 0 ? 'active' : ''}`} data-filter={cat}>
                  {cat}
                </button>
              ))}
            </div>
          )}

          <div class="projects-grid" id="projects-grid-container">
            {projects.map((proj) => (
              <article class="project-card" data-category={proj.category || 'General'}>
                {proj.image_url && (
                  <div class="project-card__image-wrap">
                    <img src={proj.image_url} alt={proj.title} class="project-card__img" loading="lazy" />
                  </div>
                )}
                <div class="project-card__content">
                  {proj.category && <span class="project-category">{proj.category}</span>}
                  <h3 class="project-title">{proj.title}</h3>
                  <p class="project-desc">{proj.description}</p>
                  
                  {proj.tags && proj.tags.length > 0 && (
                    <div class="project-tags">
                      {proj.tags.map((tag) => (
                        <span class="tag-pill">{tag}</span>
                      ))}
                    </div>
                  )}

                  <div class="project-links">
                    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="link-btn">
                      Consultar este servicio
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SERVICIOS / ESPECIALIDADES -->
    {services.length > 0 && (
      <section class="section services-section">
        <div class="container">
          <div class="section-header">
            <p class="section-tag">Soluciones</p>
            <h2 class="section-title">Servicios que Ofrezco</h2>
          </div>
          <div class="services-grid">
            {services.map((srv) => (
              <div class="service-card">
                <div class="service-card__icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                  </svg>
                </div>
                <h3 class="service-card__title">{srv.title}</h3>
                <p class="service-card__desc">{srv.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- EXPERIENCIA LABORAL -->
    {experiences.length > 0 && (
      <section class="section exp-section">
        <div class="container">
          <div class="section-header">
            <p class="section-tag">Trayectoria</p>
            <h2 class="section-title">Experiencia Profesional</h2>
          </div>
          <div class="timeline">
            {experiences.map((exp) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content">
                  <span class="timeline-period">{exp.period}</span>
                  <h3 class="timeline-role">{exp.role}</h3>
                  <p class="timeline-company">{exp.company}</p>
                  <p class="timeline-desc">{exp.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FOOTER / CTA DIRECTO -->
    <footer class="portfolio-cta">
      <div class="container portfolio-cta__inner">
        <h2>¿Tienes un proyecto en mente?</h2>
        <p>Trabajemos juntos para llevar tus requerimientos a la realidad con calidad, velocidad y soporte.</p>
        <div class="footer-cta-buttons">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--large">
            Contactar por WhatsApp
          </a>
          {profile.email && (
            <a href={`mailto:${profile.email}`} class="btn btn--secondary btn--large">
              Escribir a {profile.email}
            </a>
          )}
        </div>
      </div>
    </footer>

    <!-- BOTÓN FLOTANTE DE WHATSAPP -->
    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="floating-whatsapp"
      title="Escríbeme por WhatsApp"
      aria-label="Abrir WhatsApp"
    >
      <svg width="32" height="32" viewBox="0 0 24 24" fill="#ffffff">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      <span class="whatsapp-tooltip">¿Conversamos?</span>
    </a>

  </main>
</BaseLayout>

<style>
  .portfolio-page {
    min-height: 100vh;
    color: #1e293b;
    background: #f8fafc;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* TOP NAV */
  .top-nav {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .top-nav__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.75rem;
  }
  .top-nav__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: #475569;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .top-nav__back:hover {
    color: var(--profile-accent);
  }

  /* HERO */
  .hero-section {
    padding: 5rem 0 4.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    text-align: center;
  }
  .hero-section__inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-avatar {
    width: 88px;
    height: 88px;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, var(--profile-accent), #0f172a);
    color: #ffffff;
    font-size: 2rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 24px -8px var(--profile-accent);
    margin-bottom: 1.5rem;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(34, 197, 94, 0.12);
    color: #16a34a;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
  }
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin-bottom: 0.6rem;
    line-height: 1.1;
  }
  .hero-headline {
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    color: var(--profile-accent);
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .hero-bio {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #475569;
    margin-bottom: 2rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  .hero-meta {
    color: #64748b;
    font-size: 0.9375rem;
  }
  .location-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* BOTONES */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn--whatsapp {
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
  }
  .btn--whatsapp:hover {
    background: #20ba59;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
  }
  .btn--secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }
  .btn--secondary:hover {
    background: #f1f5f9;
  }
  .btn--large {
    padding: 1.1rem 2rem;
    font-size: 1.125rem;
  }

  /* SECCIONES COMUNES */
  .section {
    padding: 5rem 0;
  }
  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3.5rem;
  }
  .section-tag {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--profile-accent);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  /* SKILLS GRID */
  .skills-section {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
  }
  .skill-category-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.75rem;
  }
  .skill-category-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1.25rem;
    border-left: 3px solid var(--profile-accent);
    padding-left: 0.6rem;
  }
  .skill-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-pill {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }
  .skill-pill:hover {
    border-color: var(--profile-accent);
    color: var(--profile-accent);
    transform: translateY(-2px);
  }

  /* PROYECTOS */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .project-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 36px -12px rgba(0, 0, 0, 0.12);
  }
  .project-card__image-wrap {
    width: 100%;
    height: 210px;
    background: #0f172a;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .project-card:hover .project-card__img {
    transform: scale(1.05);
  }
  .project-card__content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .project-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--profile-accent);
    margin-bottom: 0.5rem;
  }
  .project-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }
  .project-desc {
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .tag-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
  }
  .project-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--profile-accent);
    text-decoration: none;
  }
  .link-btn:hover {
    text-decoration: underline;
  }

  /* SERVICIOS */
  .services-section {
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }
  .service-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.08);
  }
  .service-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    background: rgba(37, 99, 235, 0.08);
    color: var(--profile-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .service-card__title {
