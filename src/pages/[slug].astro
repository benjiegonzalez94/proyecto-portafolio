<script>
  // Filtrado dinámico de proyectos por categoría
  const filterBtns = document.querySelectorAll('[data-filter]');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const selectedCat = btn.getAttribute('data-filter');

      projectCards.forEach((card) => {
        const cardEl = card as HTMLElement;
        const cardCat = cardEl.getAttribute('data-category');

        if (selectedCat === 'Todos' || cardCat === selectedCat) {
          cardEl.style.display = 'flex';
          setTimeout(() => {
            cardEl.style.opacity = '1';
            cardEl.style.transform = 'translateY(0)';
          }, 10);
        } else {
          cardEl.style.opacity = '0';
          cardEl.style.transform = 'translateY(10px)';
          setTimeout(() => {
            cardEl.style.display = 'none';
          }, 200);
        }
      });
    });
  });
</script>

