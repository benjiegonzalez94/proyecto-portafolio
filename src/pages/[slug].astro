---
/**
 * [slug].astro — Portafolio dinámico por perfil.
 * Rutas generadas: /benjie, /nahomi, etc.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProfiles, getPortfolioBySlug } from '../lib/supabase';
import type { FullPortfolio } from '../lib/types';

export async function getStaticPaths() {
  const profiles = await getAllProfiles();
  return profiles.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const portfolioData = await getPortfolioBySlug(slug as string);

if (!portfolioData) {
  return Astro.redirect('/404');
}

const { profile, experiences, projects, services } = portfolioData;
const pageTitle = `${profile.full_name} — ${profile.headline}`;
---

<BaseLayout title={pageTitle} description={profile.bio} hideHeader={true} hideFooter={true}>
  <main class="portfolio-page" style={`--profile-accent: ${profile.theme_accent || '#2563eb'};`}>
    
    <!-- BARRA SUPERIOR DE NAVEGACIÓN Y CAMBIO DE PERFIL -->
    <nav class="top-nav" aria-label="Navegación del perfil">
      <div class="container top-nav__inner">
        <a href="/" class="top-nav__back" title="Volver al Portal Principal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span>Portal Principal</span>
        </a>

        <div class="top-nav__actions">
          <a href="/admin" class="btn-admin" title="Panel de Administración">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <span>Editar datos</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- HERO SECTION -->
    <header class="hero-section">
      <div class="container hero-section__inner">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>{profile.hero_badge || 'Disponible para proyectos'}</span>
        </div>

        <h1 class="hero-title">{profile.full_name}</h1>
        <p class="hero-headline">{profile.headline}</p>
        <p class="hero-bio">{profile.bio}</p>

        <div class="hero-cta-group">
          {profile.email && (
            <a href={`mailto:${profile.email}`} class="btn btn--primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <span>Contactar ahora</span>
            </a>
          )}
          {profile.resume_url ? (
            <a href={profile.resume_url} target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
              Descargar CV
            </a>
          ) : (
            <a href="#proyectos" class="btn btn--secondary">
              Ver proyectos destacados
            </a>
          )}
        </div>

        {profile.location && (
          <div class="hero-meta">
            <span class="location-tag">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              {profile.location}
            </span>
          </div>
        )}
      </div>
    </header>

    <!-- SERVICIOS / ESPECIALIDADES -->
    {services.length > 0 && (
      <section class="section services-section">
        <div class="container">
          <div class="section-header">
            <p class="section-tag">Especialidades</p>
            <h2 class="section-title">Servicios & Áreas de Enfoque</h2>
          </div>
          <div class="services-grid">
            {services.map((srv) => (
              <div class="service-card">
                <div class="service-card__icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                  </svg>
                </div>
                <h3 class="service-card__title">{srv.title}</h3>
                <p class="service-card__desc">{srv.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- PROYECTOS DESTACADOS -->
    {projects.length > 0 && (
      <section id="proyectos" class="section projects-section">
        <div class="container">
          <div class="section-header">
            <p class="section-tag">Portafolio</p>
            <h2 class="section-title">Proyectos Seleccionados</h2>
          </div>
          <div class="projects-grid">
            {projects.map((proj) => (
              <article class="project-card">
                {proj.image_url && (
                  <div class="project-card__image-wrap">
                    <img src={proj.image_url} alt={proj.title} class="project-card__img" loading="lazy" />
                  </div>
                )}
                <div class="project-card__content">
                  {proj.category && <span class="project-category">{proj.category}</span>}
                  <h3 class="project-title">{proj.title}</h3>
                  <p class="project-desc">{proj.description}</p>
                  
                  {proj.tags && proj.tags.length > 0 && (
                    <div class="project-tags">
                      {proj.tags.map((tag) => (
                        <span class="tag-pill">{tag}</span>
                      ))}
                    </div>
                  )}

                  <div class="project-links">
                    {proj.live_url && proj.live_url !== '#' && (
                      <a href={proj.live_url} target="_blank" rel="noopener noreferrer" class="link-btn">
                        Ver Proyecto
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                          <polyline points="15 3 21 3 21 9"/>
                          <line x1="10" x2="21" y1="14" y2="3"/>
                        </svg>
                      </a>
                    )}
                    {proj.repo_url && (
                      <a href={proj.repo_url} target="_blank" rel="noopener noreferrer" class="link-btn link-btn--muted">
                        Código Fuente
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- EXPERIENCIA LABORAL -->
    {experiences.length > 0 && (
      <section class="section exp-section">
        <div class="container">
          <div class="section-header">
            <p class="section-tag">Trayectoria</p>
            <h2 class="section-title">Experiencia Profesional</h2>
          </div>
          <div class="timeline">
            {experiences.map((exp) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content">
                  <span class="timeline-period">{exp.period}</span>
                  <h3 class="timeline-role">{exp.role}</h3>
                  <p class="timeline-company">{exp.company}</p>
                  <p class="timeline-desc">{exp.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FOOTER / CTA DIRECTO -->
    <footer class="portfolio-cta">
      <div class="container portfolio-cta__inner">
        <h2>¿Tienes un proyecto en mente?</h2>
        <p>Trabajemos juntos para llevar tus ideas a la realidad con calidad y compromiso.</p>
        {profile.email && (
          <a href={`mailto:${profile.email}`} class="btn btn--primary btn--large">
            Escríbeme a {profile.email}
          </a>
        )}
      </div>
    </footer>

  </main>
</BaseLayout>

<style>
  .portfolio-page {
    min-height: 100vh;
    color: #1e293b;
    background: #f8fafc;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* TOP NAV */
  .top-nav {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .top-nav__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.75rem;
  }
  .top-nav__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: #475569;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .top-nav__back:hover {
    color: var(--profile-accent);
  }
  .btn-admin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #64748b;
    padding: 0.4rem 0.8rem;
    border-radius: 9999px;
    background: #f1f5f9;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-admin:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  /* HERO */
  .hero-section {
    padding: 5rem 0 4rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    text-align: center;
  }
  .hero-section__inner {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(34, 197, 94, 0.1);
    color: #16a34a;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
  }
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }
  .hero-headline {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    color: var(--profile-accent);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .hero-bio {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #475569;
    margin-bottom: 2rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  .hero-meta {
    color: #64748b;
    font-size: 0.9375rem;
  }
  .location-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* BOTONES */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn--primary {
    background: var(--profile-accent);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
  .btn--primary:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
  }
  .btn--secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }
  .btn--secondary:hover {
    background: #f1f5f9;
  }
  .btn--large {
    padding: 1.1rem 2rem;
    font-size: 1.125rem;
  }

  /* SECCIONES COMUNES */
  .section {
    padding: 5rem 0;
  }
  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3.5rem;
  }
  .section-tag {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--profile-accent);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  /* SERVICIOS */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }
  .service-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.08);
    border-color: #cbd5e1;
  }
  .service-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    background: rgba(37, 99, 235, 0.08);
    color: var(--profile-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .service-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }
  .service-card__desc {
    color: #64748b;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* PROYECTOS */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .project-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -12px rgba(0, 0, 0, 0.1);
  }
  .project-card__content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .project-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--profile-accent);
    margin-bottom: 0.5rem;
  }
  .project-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }
  .project-desc {
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .tag-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
  }
  .project-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--profile-accent);
    text-decoration: none;
  }
  .link-btn:hover {
    text-decoration: underline;
  }
  .link-btn--muted {
    color: #64748b;
  }

  /* TIMELINE EXPERIENCIA */
  .timeline {
    max-width: 750px;
    margin: 0 auto;
    position: relative;
    border-left: 2px solid #e2e8f0;
    padding-left: 2rem;
  }
  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }
  .timeline-item:last-child {
    margin-bottom: 0;
  }
  .timeline-marker {
    position: absolute;
    left: -2.45rem;
    top: 0.25rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid var(--profile-accent);
  }
  .timeline-period {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--profile-accent);
    margin-bottom: 0.25rem;
  }
  .timeline-role {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.25rem;
  }
  .timeline-company {
    font-size: 0.95rem;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 0.75rem;
  }
  .timeline-desc {
    color: #475569;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* CTA FINAL */
  .portfolio-cta {
    background: #0f172a;
    color: #ffffff;
    padding: 6rem 0;
    text-align: center;
  }
  .portfolio-cta__inner {
    max-width: 650px;
  }
  .portfolio-cta h2 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .portfolio-cta p {
    font-size: 1.125rem;
    color: #94a3b8;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
</style>
