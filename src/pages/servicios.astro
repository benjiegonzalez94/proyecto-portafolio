---
/**
 * servicios.astro — Página de servicios, proceso y preguntas frecuentes.
 *
 * Los servicios y las preguntas se editan en src/data/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

// Datos estructurados: lista de servicios para los buscadores
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Servicios de ${site.name}`,
  itemListElement: site.services.map((service, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      description: service.description,
      provider: { '@type': 'Person', name: site.name },
      areaServed: 'Ecuador',
    },
  })),
};

// Datos estructurados: preguntas frecuentes (pueden aparecer en Google)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: site.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title="Servicios"
  description={`Servicios de diseño gráfico, identidad visual, edición de video, marketing digital y análisis de datos de ${site.name} en Manta, Ecuador. Precios y paquetes.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  <!-- ============================================================ CABECERA -->
  <section class="page-head has-blobs">
    <span class="blob page-head__blob" aria-hidden="true"></span>

    <div class="container">
      <nav class="crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Servicios</span>
      </nav>

      <p class="section__eyebrow">Servicios</p>
      <h1 class="page-head__title">
        Todo lo que tu marca necesita para <span class="gradient-text">verse profesional</span>
      </h1>
      <p class="page-head__lead">
        Puedes contratar un servicio suelto o el acompañamiento completo: marca, contenido, video y
        medición de resultados. Los precios son orientativos y se ajustan al alcance real de tu
        proyecto.
      </p>
    </div>
  </section>

  <!-- ============================================================ SERVICIOS -->
  <section class="section section--tight" aria-label="Listado de servicios">
    <div class="container">
      <div class="svc__grid">
        {
          site.services.map((service, i) => (
            <article class="svc card" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
              <header class="svc__head">
                <span class="svc__icon">
                  <Icon name={service.icon} size={24} />
                </span>
                <div>
                  <h2 class="svc__title">{service.title}</h2>
                  {service.price && <p class="svc__price">{service.price}</p>}
                </div>
              </header>

              <p class="svc__text">{service.description}</p>

              <h3 class="svc__subtitle">Qué incluye</h3>
              <ul class="svc__list">
                {service.includes.map((item) => (
                  <li>
                    <Icon name="check" size={16} />
                    {item}
                  </li>
                ))}
              </ul>

              <a class="btn btn--outline svc__cta" href={`/contacto?servicio=${encodeURIComponent(service.title)}`}>
                Solicitar este servicio
                <span class="btn__icon"><Icon name="arrow-right" size={17} /></span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== PROCESO -->
  <section class="section section--dark" aria-labelledby="proceso-title">
    <div class="container">
      <header class="section__head section__head--center" data-reveal>
        <p class="section__eyebrow">Cómo trabajo</p>
        <h2 id="proceso-title">Cuatro pasos, cero improvisación</h2>
        <p class="section__lead">
          Un método ordenado que te mantiene informada en todo momento y protege tus tiempos.
        </p>
      </header>

      <ol class="steps">
        {
          site.process.map((step, i) => (
            <li class="steps__item" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="steps__num">{step.step}</span>
              <h3 class="steps__title">{step.title}</h3>
              <p class="steps__text">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================================== PAQUETES -->
  <section class="section" aria-labelledby="planes-title">
    <div class="container">
      <header class="section__head section__head--center" data-reveal>
        <p class="section__eyebrow">Planes</p>
        <h2 id="planes-title">Elige el nivel de acompañamiento</h2>
        <p class="section__lead">
          Tres formas de trabajar juntas. Si tu proyecto no encaja en ninguna, escríbeme igual: lo
          armamos a la medida.
        </p>
      </header>

      <div class="plans">
        <!-- Plan 1 -->
        <article class="plan card" data-reveal>
          <h3 class="plan__name">Esencial</h3>
          <p class="plan__for">Para emprendimientos que están empezando</p>
          <p class="plan__price">
            <span>Desde</span> $180
          </p>
          <ul class="plan__list">
            <li><Icon name="check" size={16} /> Logotipo con 2 propuestas</li>
            <li><Icon name="check" size={16} /> Paleta de color y tipografías</li>
            <li><Icon name="check" size={16} /> 5 plantillas para redes</li>
            <li><Icon name="check" size={16} /> Archivos finales organizados</li>
            <li><Icon name="check" size={16} /> 2 rondas de ajustes</li>
          </ul>
          <a class="btn btn--outline plan__cta" href="/contacto?plan=Esencial">Empezar</a>
        </article>

        <!-- Plan destacado -->
        <article class="plan plan--featured card" data-reveal style="--reveal-delay:90ms">
          <span class="plan__tag">Más elegido</span>
          <h3 class="plan__name">Profesional</h3>
          <p class="plan__for">Para marcas que quieren crecer en serio</p>
          <p class="plan__price">
            <span>Desde</span> $480
          </p>
          <ul class="plan__list">
            <li><Icon name="check" size={16} /> Todo lo del plan Esencial</li>
            <li><Icon name="check" size={16} /> Manual de marca completo</li>
            <li><Icon name="check" size={16} /> 15 plantillas para redes</li>
            <li><Icon name="check" size={16} /> 1 video corto editado</li>
            <li><Icon name="check" size={16} /> Papelería y aplicaciones</li>
            <li><Icon name="check" size={16} /> 3 rondas de ajustes</li>
          </ul>
          <a class="btn btn--primary plan__cta" href="/contacto?plan=Profesional">
            Quiero este
            <span class="btn__icon"><Icon name="arrow-right" size={17} /></span>
          </a>
        </article>

        <!-- Plan 3 -->
        <article class="plan card" data-reveal style="--reveal-delay:180ms">
          <h3 class="plan__name">Integral</h3>
          <p class="plan__for">Para empresas que necesitan todo el ecosistema</p>
          <p class="plan__price">
            <span>Desde</span> $850<span class="plan__per">/mes</span>
          </p>
          <ul class="plan__list">
            <li><Icon name="check" size={16} /> Identidad visual completa</li>
            <li><Icon name="check" size={16} /> Contenido mensual para redes</li>
            <li><Icon name="check" size={16} /> 4 videos editados al mes</li>
            <li><Icon name="check" size={16} /> Campañas y publicidad</li>
            <li><Icon name="check" size={16} /> Tablero de métricas mensual</li>
            <li><Icon name="check" size={16} /> Acompañamiento continuo</li>
          </ul>
          <a class="btn btn--outline plan__cta" href="/contacto?plan=Integral">Agendar una llamada</a>
        </article>
      </div>

      <p class="plans__note" data-reveal>
        <Icon name="clock" size={16} />
        Los precios están en dólares estadounidenses y no incluyen impuestos. Cada propuesta se
        entrega por escrito antes de comenzar.
      </p>
    </div>
  </section>

  <!-- ============================================================== PREGUNTAS -->
  <section class="section faq" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <header class="section__head section__head--center" data-reveal>
        <p class="section__eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-title">Dudas resueltas antes de escribirme</h2>
      </header>

      <div class="faq__list">
        {
          site.faqs.map((faq, i) => (
            <details class="faq__item" data-reveal open={i === 0}>
              <summary class="faq__q">
                <span>{faq.question}</span>
                <span class="faq__mark" aria-hidden="true">
                  <Icon name="plus" size={18} />
                </span>
              </summary>
              <p class="faq__a">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Cuéntame qué necesita tu marca"
    text="Escríbeme con tu idea o tu problema y te propongo la mejor forma de resolverlo, con presupuesto claro desde el primer mensaje."
    buttonLabel="Pedir una cotización"
  />
</BaseLayout>

<style>
  /* ------------------------------------------------------------ Cabecera */

  .page-head {
    padding-top: clamp(7rem, 12vw, 9.5rem);
    /* Sin relleno inferior: la siguiente sección ya aporta su respiro, así
       no se acumulan dos espacios seguidos */
    padding-bottom: 0;
  }

  .page-head__blob {
    top: 2rem;
    left: -6rem;
    width: 26rem;
    height: 26rem;
    background: var(--c-tangerine);
    opacity: 0.28;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: var(--space-md);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }

  .crumbs a:hover {
    color: var(--c-violet);
    text-decoration: underline;
  }

  .page-head__title {
    max-width: 22ch;
    font-size: var(--fs-4xl);
  }

  .page-head__lead {
    max-width: 48rem;
    margin-top: var(--space-sm);
    font-size: var(--fs-lg);
    color: var(--c-muted);
  }

  /* ------------------------------------------------------------ Servicios */

  .svc__grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }

  .svc {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
  }

  .svc__head {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-sm);
  }

  .svc__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    color: var(--c-white);
    background: linear-gradient(135deg, var(--c-pink), var(--c-violet));
    border-radius: 30%;
    box-shadow: 0 10px 26px -8px rgb(124 58 237 / 55%);
  }

  .svc__title {
    font-size: var(--fs-xl);
  }

  .svc__price {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-violet);
  }

  .svc__text {
    color: var(--c-muted);
  }

  .svc__subtitle {
    margin-top: var(--space-md);
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .svc__list {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .svc__list li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--fs-sm);
  }

  .svc__list :global(svg) {
    flex-shrink: 0;
    color: var(--c-cyan);
  }

  .svc__cta {
    align-self: flex-start;
    margin-top: var(--space-md);
  }

  /* --------------------------------------------------------------- Pasos */

  .steps {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .steps__item {
    padding: var(--space-md);
    background: rgb(255 249 243 / 6%);
    border: 1px solid rgb(255 249 243 / 12%);
    border-radius: var(--radius);
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .steps__item:hover {
    background: rgb(255 249 243 / 11%);
    transform: translateY(-5px);
  }

  .steps__num {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: 1;
    color: var(--c-yellow);
  }

  .steps__title {
    font-size: var(--fs-lg);
  }

  .steps__text {
    margin-top: 0.4rem;
    font-size: var(--fs-sm);
    color: rgb(255 249 243 / 72%);
  }

  /* --------------------------------------------------------------- Planes */

  .plans {
    display: grid;
    gap: var(--space-md);
    align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-lg) var(--space-md);
    border-radius: var(--radius-lg);
  }

  .plan--featured {
    border-color: transparent;
    box-shadow: var(--shadow-color);
  }

  /* Borde superior degradado en el plan destacado */
  .plan--featured::before {
    position: absolute;
    inset: 0 0 auto;
    height: 5px;
    content: '';
    background: linear-gradient(90deg, var(--c-pink), var(--c-violet), var(--c-cyan));
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .plan__tag {
    position: absolute;
    top: -0.85rem;
    right: var(--space-md);
    padding: 0.3rem 0.9rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--c-white);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: linear-gradient(100deg, var(--c-pink), var(--c-violet));
    border-radius: var(--radius-full);
  }

  .plan__name {
    font-size: var(--fs-2xl);
  }

  .plan__for {
    margin-top: 0.25rem;
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .plan__price {
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .plan__price span:first-child {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-muted);
  }

  .plan__per {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-muted);
  }

  .plan__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-block: var(--space-md);
  }

  .plan__list li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: var(--fs-sm);
  }

  .plan__list :global(svg) {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--c-cyan);
  }

  .plan__cta {
    width: 100%;
    margin-top: auto;
  }

  .plans__note {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-lg);
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-align: center;
  }

  /* ---------------------------------------------------------- Preguntas */

  .faq {
    background: var(--c-white);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--c-cream);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .faq__item[open] {
    border-color: color-mix(in srgb, var(--c-violet) 40%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .faq__q {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  /* Oculta el triángulo por defecto del navegador */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__mark {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    color: var(--c-violet);
    background: rgb(124 58 237 / 10%);
    border-radius: 50%;
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .faq__item[open] .faq__mark {
    color: var(--c-white);
    background: var(--c-violet);
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 var(--space-md) var(--space-md);
    color: var(--c-muted);
  }

  /* ------------------------------------------------------------ Responsive */

  @media (max-width: 40rem) {
    .svc {
      padding: var(--space-md);
    }
  }
</style>
