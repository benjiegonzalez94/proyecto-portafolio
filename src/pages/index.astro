---
/**
 * index.astro — Hub y Selector Principal de Portafolios.
 * Permite seleccionar directamente entre Benjie González (TI) y Nahomi Machuca (Marketing & Diseño).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProfiles } from '../lib/supabase';

const profiles = await getAllProfiles();
---

<BaseLayout title="Portafolios Profesionales — Benjie González & Nahomi Machuca" isHome={true}>
  <main class="hub-main">
    
    <!-- HEADER BAR -->
    <header class="hub-header">
      <div class="container hub-header__inner">
        <div class="brand-logo">
          <span class="brand-dot"></span>
          <span class="brand-text">Portfolio Platform</span>
        </div>
        <a href="/admin" class="admin-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
            <path d="M7 7h.01"/>
            <path d="M17 7h.01"/>
            <path d="M7 17h.01"/>
            <path d="M17 17h.01"/>
          </svg>
          <span>Panel de Gestión</span>
        </a>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hub-hero">
      <div class="container hub-hero__inner">
        <span class="hub-badge">Directorio Profesional & Proyectos</span>
        <h1 class="hub-title">
          Soluciones Estratégicas en <span class="highlight highlight--blue">Tecnología</span> &amp; <span class="highlight highlight--pink">Diseño Creativo</span>
        </h1>
        <p class="hub-subtitle">
          Bienvenido a nuestro espacio profesional. Selecciona el portafolio especializado que deseas explorar según tus necesidades:
        </p>
      </div>
    </section>

    <!-- PERFILES GRID (BENJIE & NAHOMI) -->
    <section class="profiles-section">
      <div class="container">
        <div class="profiles-grid">
          
          {profiles.map((p) => {
            const isBenjie = p.slug === 'benjie';
            const accentColor = p.theme_accent || (isBenjie ? '#2563eb' : '#ec4899');
            const roleBadge = isBenjie ? 'Ingeniería & Tecnología' : 'Creatividad & Marketing';
            const iconSvg = isBenjie ? 'code' : 'palette';

            return (
              <article class="profile-card" style={`--card-accent: ${accentColor};`}>
                <div class="profile-card__accent-bar"></div>
                
                <div class="profile-card__body">
                  <div class="profile-card__top">
                    <span class="role-pill">{roleBadge}</span>
                    <span class="status-dot-wrap" title="Disponible para contratación">
                      <span class="status-dot"></span>
                      Disponible
                    </span>
                  </div>

                  <div class="profile-avatar-row">
                    <div class="profile-avatar">
                      {p.slug === 'benjie' ? 'BG' : 'NM'}
                    </div>
                    <div>
                      <h2 class="profile-name">{p.full_name}</h2>
                      <p class="profile-headline">{p.headline}</p>
                    </div>
                  </div>

                  <p class="profile-bio">{p.bio}</p>

                  <div class="profile-highlights">
                    {isBenjie ? (
                      <ul>
                        <li>✓ Desarrollo de Software &amp; Aplicaciones Web</li>
                        <li>✓ Infraestructura Cloud, Servidores &amp; Redes</li>
                        <li>✓ Soporte Técnico Corporativo &amp; Automatización</li>
                      </ul>
                    ) : (
                      <ul>
                        <li>✓ Branding &amp; Creación de Identidad Visual</li>
                        <li>✓ Edición de Video Profesional &amp; Motion Graphics</li>
                        <li>✓ Estrategia de Contenidos &amp; Redes Sociales</li>
                      </ul>
                    )}
                  </div>

                  <div class="profile-card__footer">
                    <a href={`/${p.slug}`} class="enter-btn">
                      <span>Ver Portafolio Completo</span>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}

        </div>
      </div>
    </section>

    <!-- FOOTER INFORMACIÓN -->
    <footer class="hub-footer">
      <div class="container hub-footer__inner">
        <p>Sistema multi-portafolio administrable con Astro y Supabase.</p>
        <div class="quick-links">
          <a href="/benjie">Directo a Benjie</a>
          <span>•</span>
          <a href="/nahomi">Directo a Nahomi</a>
          <span>•</span>
          <a href="/admin">Acceso CMS</a>
        </div>
      </div>
    </footer>

  </main>
</BaseLayout>

<style>
  .hub-main {
    min-height: 100vh;
    background: radial-gradient(circle at top center, #1e1b4b 0%, #0f172a 45%, #020617 100%);
    color: #f8fafc;
    display: flex;
    flex-direction: column;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* HEADER */
  .hub-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
  }
  .hub-header__inner {
    height: 4.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 12px #38bdf8;
  }
  .admin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    padding: 0.45rem 0.9rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
  }
  .admin-link:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  /* HERO */
  .hub-hero {
    padding: 5rem 0 3.5rem;
    text-align: center;
  }
  .hub-hero__inner {
    max-width: 820px;
  }
  .hub-badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgba(56, 189, 248, 0.2);
    margin-bottom: 1.5rem;
  }
  .hub-title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }
  .highlight--blue {
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .highlight--pink {
    background: linear-gradient(135deg, #f472b6, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hub-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 auto;
  }

  /* GRID DE PERFILES */
  .profiles-section {
    padding-bottom: 5rem;
    flex-grow: 1;
  }
  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2.5rem;
    max-width: 1050px;
    margin: 0 auto;
  }
  .profile-card {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.25rem;
    overflow: hidden;
    backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .profile-card:hover {
    transform: translateY(-6px);
    border-color: var(--card-accent);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), 0 0 25px -5px var(--card-accent);
  }
  .profile-card__accent-bar {
    height: 5px;
    background: var(--card-accent);
  }
  .profile-card__body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .profile-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.75rem;
  }
  .role-pill {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--card-accent);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .status-dot-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4ade80;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 6px #4ade80;
  }

  .profile-avatar-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .profile-avatar {
    width: 64px;
    height: 64px;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
    border: 2px solid var(--card-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    flex-shrink: 0;
  }
  .profile-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }
  .profile-headline {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  .profile-bio {
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }
  .profile-highlights {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.85rem;
    padding: 1.15rem;
    margin-bottom: 2rem;
  }
  .profile-highlights ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #94a3b8;
  }

  .profile-card__footer {
    margin-top: auto;
  }
  .enter-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 1rem;
    border-radius: 0.85rem;
    background: var(--card-accent);
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .enter-btn:hover {
    filter: brightness(1.15);
    box-shadow: 0 8px 20px -4px var(--card-accent);
  }

  /* FOOTER */
  .hub-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2.5rem 0;
    font-size: 0.875rem;
    color: #64748b;
    text-align: center;
  }
  .hub-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }
  .quick-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .quick-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .quick-links a:hover {
    color: #38bdf8;
  }
</style>
