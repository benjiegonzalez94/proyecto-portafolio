---
/**
 * index.astro — Plataforma & Generador de Portafolios Online (Portfolio Builder).
 * Landing principal con vitrina de perfiles insignia (Benjie & Nahomi), plantillas y generador gratis.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProfiles, AVAILABLE_TEMPLATES } from '../lib/supabase';

const profiles = await getAllProfiles();
---

<BaseLayout 
  title="Folio" 
  description="Crea tu portafolio web profesional con plantillas predefinidas, gestión completa de proyectos y subida de imágenes."
  isHome={true} 
  hideHeader={true} 
  hideFooter={true}
>
  <main class="hub-main">
    
    <!-- HEADER BAR -->
    <header class="hub-header">
      <div class="container hub-header__inner">
        <a href="/" class="brand-logo">
          <span class="brand-dot"></span>
          <span class="brand-text">Folio</span>
        </a>

        <div class="header-actions">
          <a href="/login" class="nav-btn nav-btn--ghost">
            <span>Iniciar Sesión</span>
          </a>
          <a href="/crear" class="nav-btn nav-btn--primary">
            <span>✨ Crear Portafolio Gratis</span>
          </a>
        </div>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hub-hero">
      <div class="container hub-hero__inner">
        <div class="hero-badge-pill">
          <span class="badge-sparkle">🚀</span>
          <span>Plataforma de Portafolios Multi-Usuario</span>
        </div>
        
        <h1 class="hub-title">
          Construye tu <span class="highlight highlight--blue">Portafolio Web</span> con Plantillas de Alto Impacto
        </h1>
        
        <p class="hub-subtitle">
          Elige entre diseños profesionales predefinidos, personaliza tu información, sube imágenes de tus proyectos y publica tu enlace personal en menos de un minuto.
        </p>

        <div class="hero-cta-row">
          <a href="/crear" class="cta-btn cta-btn--main">
            <span>Comenzar Ahora — Es Gratis</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="#destacados" class="cta-btn cta-btn--secondary">
            <span>Explorar Ejemplos Destacados ↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- VITRINA DE PERFILES INSIGNIA -->
    <section id="destacados" class="profiles-section">
      <div class="container">
        <div class="section-title-wrap">
          <span class="sub-badge">Casos Emblemáticos</span>
          <h2 class="section-heading">Portafolios Publicados en la Plataforma</h2>
          <p class="section-desc">Explora el trabajo y la presencia online de nuestros creadores destacados:</p>
        </div>

        <div class="profiles-grid">
          {profiles.map((p) => {
            const isBenjie = p.slug === 'benjie';
            const accentColor = p.theme_accent || (isBenjie ? '#2563eb' : '#ec4899');
            const roleBadge = isBenjie ? 'Ingeniería & TI' : 'Creatividad & Multimedia';
            const templateName = isBenjie ? 'Plantilla Tech' : 'Plantilla Creative';

            return (
              <article class="profile-card" style={`--card-accent: ${accentColor};`}>
                <div class="profile-card__accent-bar"></div>
                
                <div class="profile-card__body">
                  <div class="profile-card__top">
                    <span class="role-pill">{roleBadge}</span>
                    <span class="template-tag">{templateName}</span>
                  </div>

                  <div class="profile-avatar-row">
                    <div class="profile-avatar">
                      {p.avatar_url ? (
                        <img src={p.avatar_url} alt={p.full_name} class="avatar-img-hub" />
                      ) : (
                        <span>{p.slug === 'benjie' ? 'BG' : (p.slug === 'nahomi' ? 'NM' : p.full_name.slice(0, 2).toUpperCase())}</span>
                      )}
                    </div>
                    <div>
                      <h3 class="profile-name">{p.full_name}</h3>
                      <p class="profile-headline">{p.headline}</p>
                    </div>
                  </div>

                  <p class="profile-bio">{p.bio}</p>

                  <div class="profile-highlights">
                    {isBenjie ? (
                      <ul>
                        <li>✓ Desarrollo de Software &amp; Aplicaciones Web</li>
                        <li>✓ Infraestructura Cloud, Servidores &amp; Redes</li>
                        <li>✓ Soporte Técnico Corporativo &amp; Automatización</li>
                      </ul>
                    ) : (
                      <ul>
                        <li>✓ Branding &amp; Creación de Identidad Visual</li>
                        <li>✓ Edición de Video Profesional &amp; Motion Graphics</li>
                        <li>✓ Estrategia de Contenidos &amp; Redes Sociales</li>
                      </ul>
                    )}
                  </div>

                  <div class="profile-card__footer">
                    <a href={`/${p.slug}`} class="enter-btn">
                      <span>Ver Portafolio en Vivo</span>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE PLANTILLAS DISPONIBLES -->
    <section class="templates-section">
      <div class="container">
        <div class="section-title-wrap">
          <span class="sub-badge">Diseños Integrados</span>
          <h2 class="section-heading">Plantillas Listas para Usar</h2>
          <p class="section-desc">Selecciona la estética que mejor comunique tu propuesta de valor:</p>
        </div>

        <div class="templates-preview-grid">
          {AVAILABLE_TEMPLATES.map((tmpl) => (
            <div class="tmpl-card">
              <div class="tmpl-card-header" style={`background: ${tmpl.previewBg};`}>
                <span class="tmpl-badge-pill">{tmpl.badge}</span>
              </div>
              <div class="tmpl-card-body">
                <h3 class="tmpl-card-name">{tmpl.name}</h3>
                <span class="tmpl-card-cat">{tmpl.category}</span>
                <p class="tmpl-card-desc">{tmpl.description}</p>
                <a href="/crear" class="btn-use-tmpl">
                  <span>Usar esta plantilla →</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BANNER FINAL CTA -->
    <section class="final-cta-section">
      <div class="container">
        <div class="final-cta-box">
          <h2 class="final-cta-title">¿Listo para presentar tus proyectos al mundo?</h2>
          <p class="final-cta-subtitle">Crea tu cuenta gratis hoy y personaliza tu propio portafolio con facilidad.</p>
          <a href="/crear" class="cta-btn cta-btn--main">
            <span>Crear mi Portafolio Gratis 🚀</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER INFORMACIÓN -->
    <footer class="hub-footer">
      <div class="container hub-footer__inner">
        <p>© 2026 Folio — Desarrollado con Astro 5 y Supabase.</p>
        <div class="quick-links">
          <a href="/crear">Crear Portafolio</a>
          <span>•</span>
          <a href="/login">Iniciar Sesión</a>
          <span>•</span>
          <a href="/admin">Panel CMS</a>
        </div>
      </div>
    </footer>

  </main>
</BaseLayout>

<style>
  .hub-main {
    min-height: 100vh;
    background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0f172a 40%, #020617 100%);
    color: #f8fafc;
    display: flex;
    flex-direction: column;
    font-family: inherit;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* HEADER */
  .hub-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .hub-header__inner {
    height: 4.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #ffffff;
  }

  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3b82f6;
    box-shadow: 0 0 12px #3b82f6;
  }

  .brand-text {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #ffffff 0%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.15rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-btn--ghost {
    color: #cbd5e1;
  }
  .nav-btn--ghost:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-btn--primary {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }
  .nav-btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
  }

  /* HERO */
  .hub-hero {
    padding: 5.5rem 0 4rem;
    text-align: center;
  }

  .hub-hero__inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    background: rgba(37, 99, 235, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #60a5fa;
    font-size: 0.8125rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: 0.03em;
  }

  .hub-title {
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
    color: #ffffff;
  }

  .highlight--blue {
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hub-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: #94a3b8;
    max-width: 720px;
    margin: 0 0 2.25rem 0;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.75rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-btn--main {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
  }
  .cta-btn--main:hover {
    background: linear-gradient(135deg, #1d4ed8, #1e40af);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.5);
  }

  .cta-btn--secondary {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #f8fafc;
  }
  .cta-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  /* SECCIONES COMUNES */
  .section-title-wrap {
    text-align: center;
    margin-bottom: 3rem;
  }
  .sub-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #60a5fa;
  }
  .section-heading {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0.4rem 0 0.5rem 0;
    color: #ffffff;
    letter-spacing: -0.02em;
  }
  .section-desc {
    font-size: 1rem;
    color: #94a3b8;
    margin: 0;
  }

  /* PROFILES GRID */
  .profiles-section {
    padding: 3rem 0 5rem;
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .profile-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.25rem;
    overflow: hidden;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .profile-card:hover {
    transform: translateY(-6px);
    border-color: var(--card-accent);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
  }

  .profile-card__accent-bar {
    height: 5px;
    background: var(--card-accent);
  }

  .profile-card__body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .profile-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .role-pill {
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
  }

  .template-tag {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .profile-avatar-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .profile-avatar {
    width: 68px;
    height: 68px;
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--card-accent), #0f172a);
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 8px 20px -4px var(--card-accent);
    overflow: hidden;
  }

  .avatar-img-hub {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.25rem 0;
  }

  .profile-headline {
    font-size: 0.875rem;
    color: var(--card-accent);
    font-weight: 600;
    margin: 0;
  }

  .profile-bio {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 1.5rem 0;
  }

  .profile-highlights {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  .profile-highlights ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .profile-highlights li {
    font-size: 0.8125rem;
    color: #cbd5e1;
    font-weight: 500;
  }

  .profile-card__footer {
    margin-top: auto;
  }

  .enter-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--card-accent);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.25rem;
    border-radius: 0.65rem;
    transition: all 0.2s ease;
  }

  .enter-btn:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }

  /* PLANTILLAS SECCIÓN */
  .templates-section {
    padding: 4rem 0 5rem;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .templates-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .tmpl-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease;
  }

  .tmpl-card:hover {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.4);
  }

  .tmpl-card-header {
    height: 100px;
    padding: 1rem;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }

  .tmpl-badge-pill {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }

  .tmpl-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .tmpl-card-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .tmpl-card-cat {
    font-size: 0.75rem;
    color: #60a5fa;
    font-weight: 600;
  }

  .tmpl-card-desc {
    margin: 0.25rem 0 1rem 0;
    font-size: 0.8125rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  .btn-use-tmpl {
    margin-top: auto;
    color: #38bdf8;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 700;
    transition: color 0.2s ease;
  }
  .btn-use-tmpl:hover {
    color: #7dd3fc;
  }

  /* FINAL CTA */
  .final-cta-section {
    padding: 3rem 0 5rem;
  }

  .final-cta-box {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15) 0%, rgba(236, 72, 153, 0.1) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.5rem;
    padding: 3.5rem 2rem;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .final-cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.75rem 0;
  }

  .final-cta-subtitle {
    font-size: 1.05rem;
    color: #cbd5e1;
    margin: 0 0 2rem 0;
  }

  /* FOOTER */
  .hub-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2.25rem 0;
    margin-top: auto;
    background: rgba(2, 6, 23, 0.8);
  }

  .hub-footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    color: #64748b;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .quick-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quick-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .quick-links a:hover {
    color: #ffffff;
  }
</style>
