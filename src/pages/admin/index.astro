  inputProjFile?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file || !currentPortfolio) return;

    openCropTool(file, 'project', async (optimizedFile) => {
      if (projFileStatus) projFileStatus.textContent = '⏳ Subiendo imagen optimizada...';

      const { url, error } = await uploadMediaFile(optimizedFile, 'projects', currentPortfolio.profile.slug);

      if (error || !url) {
        alert(`Error al subir imagen: ${error}`);
        if (projFileStatus) projFileStatus.textContent = 'Error al subir';
        return;
      }

      inputProjUrl.value = url;
      if (projFileStatus) projFileStatus.textContent = '✓ Imagen optimizada';
      showToast('Captura de proyecto optimizada y guardada con éxito', 'success');
    });

    (e.target as HTMLInputElement).value = '';
  });

  // Guardar proyecto
  formProject?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentPortfolio) return;

    const title = (document.getElementById('proj-title') as HTMLInputElement).value.trim();
    const description = (document.getElementById('proj-desc') as HTMLTextAreaElement).value.trim();
    const category = (document.getElementById('proj-category') as HTMLInputElement).value.trim() || 'General';
    const tagsStr = (document.getElementById('proj-tags') as HTMLInputElement).value.trim();
    const live_url = (document.getElementById('proj-live') as HTMLInputElement).value.trim();
    const repo_url = (document.getElementById('proj-repo') as HTMLInputElement).value.trim();
    const image_url = inputProjUrl.value.trim();
    const tags = tagsStr ? tagsStr.split(',').map((t) => t.trim()) : [];

    const newProj: Project = {
      id: `proj-${Date.now()}`,
      profile_id: currentPortfolio.profile.id,
      title,
      description,
      category,
      tags,
      live_url,
      repo_url,
      image_url,
      featured: true,
      order_index: currentPortfolio.projects.length + 1,
    };

    if (supabase && isSupabaseConfigured) {
      const { data, error } = await supabase.from('projects').insert({
        profile_id: currentPortfolio.profile.id,
        title,
        description,
        category,
        tags,
        live_url,
        repo_url,
        image_url,
        featured: true,
        order_index: newProj.order_index,
      }).select().single();

      if (!error && data) {
        newProj.id = data.id;
      }
    }

    currentPortfolio.projects.push(newProj);
    renderProjects(currentPortfolio);
    if (projectModal) projectModal.style.display = 'none';
  });

  // 10. RENDER LISTAS
  function renderProjects(portfolio: FullPortfolio) {
    const container = document.getElementById('projects-list-container');
    if (!container) return;
    if (portfolio.projects.length === 0) {
      container.innerHTML = '<p class="empty-text">No hay proyectos agregados todavía. Esta sección se mantendrá oculta en tu portafolio público hasta que agregues al menos uno.</p>';
      return;
    }

    container.innerHTML = portfolio.projects
      .map(
        (proj, idx) => `
      <div class="item-row">
        ${proj.image_url ? `<img src="${proj.image_url}" alt="${proj.title}" class="item-thumb" />` : ''}
        <div class="item-info">
          <strong>${proj.title}</strong>
          <span class="item-sub">${proj.category || 'General'}</span>
          <p class="item-desc">${proj.description}</p>
        </div>
        <div class="item-actions">
          <button class="btn btn-sm btn-delete" data-del-proj="${idx}">Eliminar</button>
        </div>
      </div>
    `
      )
      .join('');

    container.querySelectorAll('[data-del-proj]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-del-proj'));
        const proj = portfolio.projects[idx];
        if (proj && supabase && isSupabaseConfigured) {
          const { error } = await supabase.from('projects').delete().eq('id', proj.id);
          if (error) {
            showToast(`Error al eliminar proyecto: ${error.message}`, 'error');
            return;
          }
        }
        portfolio.projects.splice(idx, 1);
        renderProjects(portfolio);
        showToast('Proyecto eliminado con éxito', 'success');
      });
    });
  }

  function renderExperiences(portfolio: FullPortfolio) {
    const container = document.getElementById('exp-list-container');
    if (!container) return;
    if (portfolio.experiences.length === 0) {
      container.innerHTML = '<p class="empty-text">No hay experiencias registradas. Esta sección se mantendrá oculta en tu portafolio público hasta que agregues al menos una.</p>';
      return;
    }

    container.innerHTML = portfolio.experiences
      .map(
        (exp, idx) => `
      <div class="item-row">
        <div class="item-info">
          <strong>${exp.role}</strong>
          <span class="item-company">${exp.company}</span>
          <span class="item-sub">${exp.period}</span>
          <p class="item-desc">${exp.description}</p>
        </div>
        <div class="item-actions">
          <button class="btn btn-sm btn-delete" data-del-exp="${idx}">Eliminar</button>
        </div>
      </div>
    `
      )
      .join('');

    container.querySelectorAll('[data-del-exp]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-del-exp'));
        const exp = portfolio.experiences[idx];
        if (exp && supabase && isSupabaseConfigured) {
          const { error } = await supabase.from('experiences').delete().eq('id', exp.id);
          if (error) {
            showToast(`Error al eliminar experiencia: ${error.message}`, 'error');
            return;
          }
        }
        portfolio.experiences.splice(idx, 1);
        renderExperiences(portfolio);
        showToast('Experiencia eliminada con éxito', 'success');
      });
    });
  }

  function renderServices(portfolio: FullPortfolio) {
    const container = document.getElementById('srv-list-container');
    if (!container) return;
    if (portfolio.services.length === 0) {
      container.innerHTML = '<p class="empty-text">No hay servicios registrados. Esta sección se mantendrá oculta en tu portafolio público hasta que agregues al menos uno.</p>';
      return;
    }

    container.innerHTML = portfolio.services
      .map(
        (srv, idx) => `
      <div class="item-row">
        <div class="item-info">
          <strong>${srv.title}</strong>
          <p class="item-desc">${srv.description}</p>
        </div>
        <div class="item-actions">
          <button class="btn btn-sm btn-delete" data-del-srv="${idx}">Eliminar</button>
        </div>
      </div>
    `
      )
      .join('');

    container.querySelectorAll('[data-del-srv]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-del-srv'));
        const srv = portfolio.services[idx];
        if (srv && supabase && isSupabaseConfigured) {
          const { error } = await supabase.from('services').delete().eq('id', srv.id);
          if (error) {
            showToast(`Error al eliminar servicio: ${error.message}`, 'error');
            return;
          }
        }
        portfolio.services.splice(idx, 1);
        renderServices(portfolio);
        showToast('Servicio eliminado con éxito', 'success');
      });
    });
  }

  // Agregar experiencia
  document.getElementById('btn-add-exp')?.addEventListener('click', async () => {
    if (!currentPortfolio) return;
    const role = prompt('Cargo / Rol:');
    if (!role) return;
    const company = prompt('Empresa o entidad:') || '';
    const period = prompt('Periodo (ej: 2023 - Presente):') || '2024';

    const newExp = {
      id: `exp-${Date.now()}`,
      profile_id: currentPortfolio.profile.id,
      role,
      company,
      period,
      description: 'Responsabilidades y logros principales.',
      order_index: currentPortfolio.experiences.length + 1,
    };

    if (supabase && isSupabaseConfigured) {
      const { data } = await supabase.from('experiences').insert({
        profile_id: currentPortfolio.profile.id,
        role,
        company,
        period,
        description: newExp.description,
        order_index: newExp.order_index,
      }).select().single();
      if (data) newExp.id = data.id;
    }

    currentPortfolio.experiences.push(newExp);
    renderExperiences(currentPortfolio);
  });

  // Agregar servicio
  document.getElementById('btn-add-srv')?.addEventListener('click', async () => {
    if (!currentPortfolio) return;
    const title = prompt('Título del servicio:');
    if (!title) return;
    const description = prompt('Descripción del servicio:') || '';

    const newSrv = {
      id: `srv-${Date.now()}`,
      profile_id: currentPortfolio.profile.id,
      title,
      description,
      icon: 'code',
      order_index: currentPortfolio.services.length + 1,
    };

    if (supabase && isSupabaseConfigured) {
      const { data } = await supabase.from('services').insert({
        profile_id: currentPortfolio.profile.id,
        title,
        description,
        icon: 'code',
        order_index: newSrv.order_index,
      }).select().single();
      if (data) newSrv.id = data.id;
    }

    currentPortfolio.services.push(newSrv);
    renderServices(currentPortfolio);
  });

  // Selector de perfil cambio
  selectProfile?.addEventListener('change', (e) => {
    const slug = (e.target as HTMLSelectElement).value;
    loadProfileData(slug);
  });

  // 10. ACTIVAR PLANTILLAS VISUALES DESDE EL CMS
  document.querySelectorAll('.btn-activate-tmpl').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const tmplId = (e.currentTarget as HTMLElement).getAttribute('data-set-tmpl');
      if (!tmplId || !currentPortfolio) return;

      currentPortfolio.profile.template_id = tmplId;

      if (supabase && isSupabaseConfigured) {
        try {
          const { error } = await supabase
            .from('profiles')
            .update({ template_id: tmplId, updated_at: new Date().toISOString() })
            .eq('id', currentPortfolio.profile.id);

          if (error) throw error;
          showToast(`Plantilla "${tmplId}" activada con éxito`, 'success');
        } catch (err: any) {
          showToast(`Error al cambiar plantilla: ${err.message}`, 'error');
        }
      } else {
        showToast(`Plantilla "${tmplId}" cambiada localmente`, 'info');
      }

      populateProfileForm(currentPortfolio);
    });
  });

  // 11. CAMBIAR PREFERENCIA DE MODO (OSCURO / CLARO)
  document.querySelectorAll('.admin-mode-card').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const mode = (e.currentTarget as HTMLElement).getAttribute('data-set-mode') || 'dark';
      if (!currentPortfolio) return;

      currentPortfolio.profile.theme_mode = mode;

      if (supabase && isSupabaseConfigured) {
        try {
          const { error } = await supabase
            .from('profiles')
            .update({ theme_mode: mode, updated_at: new Date().toISOString() })
            .eq('id', currentPortfolio.profile.id);

          if (error) throw error;
          showToast(`Preferencia de ${mode === 'dark' ? 'Modo Oscuro' : 'Modo Claro'} guardada`, 'success');
        } catch (err: any) {
          showToast(`Error al guardar modo: ${err.message}`, 'error');
        }
      } else {
        showToast(`Modo cambiado a ${mode} localmente`, 'info');
      }

      populateProfileForm(currentPortfolio);
    });
  });

  // ==========================================
  // 12. HERRAMIENTA DE RECORTE & OPTIMIZACIÓN
  // ==========================================
  const cropModal = document.getElementById('crop-modal');
  const cropCanvas = document.getElementById('crop-canvas') as HTMLCanvasElement;
  const cropFrameGuide = document.getElementById('crop-frame-guide');
  const cropZoomRange = document.getElementById('crop-zoom-range') as HTMLInputElement;
  const cropOrigSize = document.getElementById('crop-orig-size');
  const cropBtnConfirm = document.getElementById('crop-btn-confirm');
  const cropBtnCancel = document.getElementById('crop-btn-cancel');
  const cropModalClose = document.getElementById('crop-modal-close');
  const cropBtnReset = document.getElementById('crop-btn-reset');
  const cropModalTitle = document.getElementById('crop-modal-title');

  let cropSourceImage: HTMLImageElement | null = null;
  let cropType: 'avatar' | 'project' = 'avatar';
  let cropCallback: ((file: File) => void) | null = null;
  let cropOriginalFileName: string = 'image.png';

  let cropState = {
    zoom: 1,
    offsetX: 0,
    offsetY: 0,
    isDragging: false,
    dragStartX: 0,
    dragStartY: 0,
  };

  function openCropTool(file: File, type: 'avatar' | 'project', onConfirm: (optimizedFile: File) => void) {
    if (!cropModal || !cropCanvas) return;
    cropType = type;
    cropCallback = onConfirm;
    cropOriginalFileName = file.name;

    if (cropModalTitle) {
      cropModalTitle.textContent = type === 'avatar' ? 'Recortar Foto de Perfil' : 'Ajustar Imagen de Proyecto';
    }

    if (cropFrameGuide) {
      if (type === 'avatar') {
        cropFrameGuide.style.borderRadius = '50%';
        cropFrameGuide.style.inset = '20px';
      } else {
        cropFrameGuide.style.borderRadius = '0.75rem';
        cropFrameGuide.style.inset = '20px';
      }
    }

    if (cropOrigSize) {
      cropOrigSize.textContent = `${Math.round(file.size / 1024)} KB (${file.type})`;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        cropSourceImage = img;
        cropState = {
          zoom: 1,
          offsetX: 0,
          offsetY: 0,
          isDragging: false,
          dragStartX: 0,
          dragStartY: 0,
        };
        if (cropZoomRange) cropZoomRange.value = '1';
        drawCropCanvas();
        cropModal.style.display = 'flex';
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  function drawCropCanvas() {
    if (!cropCanvas || !cropSourceImage) return;
    const ctx = cropCanvas.getContext('2d');
    if (!ctx) return;

    const cw = cropCanvas.width;
    const ch = cropCanvas.height;

    ctx.clearRect(0, 0, cw, ch);
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, 0, cw, ch);

    // Calcular escala base para cubrir canvas
    const imgRatio = cropSourceImage.width / cropSourceImage.height;
    const canvasRatio = cw / ch;

    let baseW = cw;
    let baseH = ch;
    if (imgRatio > canvasRatio) {
      baseH = ch;
      baseW = ch * imgRatio;
    } else {
      baseW = cw;
      baseH = cw / imgRatio;
    }

    const finalW = baseW * cropState.zoom;
    const finalH = baseH * cropState.zoom;

    const x = (cw - finalW) / 2 + cropState.offsetX;
    const y = (ch - finalH) / 2 + cropState.offsetY;

    ctx.drawImage(cropSourceImage, x, y, finalW, finalH);
  }

  // Eventos de arrastre en Canvas
  cropCanvas?.addEventListener('mousedown', (e) => {
    cropState.isDragging = true;
    cropState.dragStartX = e.clientX - cropState.offsetX;
    cropState.dragStartY = e.clientY - cropState.offsetY;
    cropCanvas.style.cursor = 'grabbing';
  });

  window.addEventListener('mousemove', (e) => {
    if (!cropState.isDragging) return;
    cropState.offsetX = e.clientX - cropState.dragStartX;
    cropState.offsetY = e.clientY - cropState.dragStartY;
    drawCropCanvas();
  });

  window.addEventListener('mouseup', () => {
    if (cropState.isDragging) {
      cropState.isDragging = false;
      if (cropCanvas) cropCanvas.style.cursor = 'grab';
    }
  });

  // Zoom
  cropZoomRange?.addEventListener('input', (e) => {
    cropState.zoom = parseFloat((e.target as HTMLInputElement).value);
    drawCropCanvas();
  });

  cropBtnReset?.addEventListener('click', () => {
    cropState = {
      zoom: 1,
      offsetX: 0,
      offsetY: 0,
      isDragging: false,
      dragStartX: 0,
      dragStartY: 0,
    };
    if (cropZoomRange) cropZoomRange.value = '1';
    drawCropCanvas();
  });

  function closeCropModal() {
    if (cropModal) cropModal.style.display = 'none';
    cropSourceImage = null;
    cropCallback = null;
  }

  cropBtnCancel?.addEventListener('click', closeCropModal);
  cropModalClose?.addEventListener('click', closeCropModal);

  // Confirmar recorte y exportar a WebP
  cropBtnConfirm?.addEventListener('click', () => {
    if (!cropCanvas || !cropSourceImage || !cropCallback) return;

    // Crear canvas de salida de alta resolución optimizada
    const outCanvas = document.createElement('canvas');
    const outSize = cropType === 'avatar' ? 600 : 1200;
    outCanvas.width = outSize;
    outCanvas.height = cropType === 'avatar' ? 600 : 800;
    const outCtx = outCanvas.getContext('2d');

    if (!outCtx) return;

    // Dibujar lo que está en el canvas principal escalado a resolución nítida
    outCtx.drawImage(cropCanvas, 0, 0, cropCanvas.width, cropCanvas.height, 0, 0, outCanvas.width, outCanvas.height);

    outCanvas.toBlob(
      (blob) => {
        if (!blob) {
          showToast('Error al optimizar imagen', 'error');
          return;
        }

        const cleanName = cropOriginalFileName.replace(/\.[^/.]+$/, '');
        const optimizedFile = new File([blob], `${cleanName}.webp`, { type: 'image/webp' });

        if (cropCallback) {
          cropCallback(optimizedFile);
        }
        closeCropModal();
      },
      'image/webp',
      0.88
    );
  });

  // ==========================================
  // 13. GESTIÓN DE HABILIDADES Y STACK TÉCNICO
  // ==========================================
  function renderSkillsList(portfolio: FullPortfolio) {
    const container = document.getElementById('skills-list-container');
    if (!container) return;

    const skillsData = portfolio.profile.skills_data || [];

    if (skillsData.length === 0) {
      container.innerHTML = '<p class="empty-text">No hay categorías de habilidades registradas. Esta sección se mantendrá oculta en tu portafolio público hasta que añadas al menos una categoría.</p>';
      return;
    }

    container.innerHTML = skillsData
      .map(
        (cat: any, catIdx: number) => {
          const catTitle = cat.title || cat.category || '';
          const skillsList = Array.isArray(cat.skills) ? cat.skills.join(', ') : '';
          return `
      <div class="item-row" style="flex-direction: column; align-items: stretch; gap: 0.75rem;" data-cat-idx="${catIdx}">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
          <input 
            type="text" 
            class="cat-title-input" 
            data-cat-edit="${catIdx}" 
            value="${catTitle.replace(/"/g, '&quot;')}" 
            placeholder="Nombre de Categoría (ej: Frontend, Backend, UI/UX)"
            style="font-size: 1.1rem; font-weight: 700; color: #0f172a; padding: 0.4rem 0.6rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; flex: 1;"
          />
          <button class="btn btn-sm btn-delete" data-del-cat="${catIdx}">Eliminar Categoría</button>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.35rem;">
          <label style="font-size: 0.825rem; font-weight: 600; color: #64748b;">
            Habilidades / Tecnologías (separadas por coma):
          </label>
          <input 
            type="text" 
            class="cat-skills-input" 
            data-skills-edit="${catIdx}" 
            value="${skillsList.replace(/"/g, '&quot;')}" 
            placeholder="Ej: TypeScript, React, Astro, Node.js"
            style="padding: 0.5rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; font-size: 0.925rem;"
          />
        </div>
      </div>
    `;
        }
      )
      .join('');

    // Listeners para editar en tiempo real
    container.querySelectorAll('.cat-title-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const idx = Number((e.target as HTMLElement).getAttribute('data-cat-edit'));
        const val = (e.target as HTMLInputElement).value;
        if (portfolio.profile.skills_data?.[idx]) {
          portfolio.profile.skills_data[idx].title = val;
          (portfolio.profile.skills_data[idx] as any).category = val;
        }
      });
    });

    container.querySelectorAll('.cat-skills-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const idx = Number((e.target as HTMLElement).getAttribute('data-skills-edit'));
        if (portfolio.profile.skills_data?.[idx]) {
          const raw = (e.target as HTMLInputElement).value;
          portfolio.profile.skills_data[idx].skills = raw.split(',').map((s) => s.trim()).filter(Boolean);
        }
      });
    });

    // Listeners para eliminar categoría
    container.querySelectorAll('[data-del-cat]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-del-cat'));
        if (portfolio.profile.skills_data) {
          portfolio.profile.skills_data.splice(idx, 1);
          renderSkillsList(portfolio);
          showToast('Categoría eliminada. Recuerda pulsar "Guardar Cambios de Habilidades" para confirmar.', 'info');
        }
      });
    });
  }

  // Añadir nueva categoría
  document.getElementById('btn-add-skill-category')?.addEventListener('click', () => {
    if (!currentPortfolio) return;
    if (!currentPortfolio.profile.skills_data) {
      currentPortfolio.profile.skills_data = [];
    }

    currentPortfolio.profile.skills_data.push({
      title: 'Nueva Categoría',
      skills: ['Herramienta 1', 'Herramienta 2'],
    } as any);

    renderSkillsList(currentPortfolio);
  });

  // Guardar habilidades en Supabase
  document.getElementById('btn-save-skills')?.addEventListener('click', async () => {
    if (!currentPortfolio) return;

    const skillsStatus = document.getElementById('skills-save-status');
    if (skillsStatus) {
      skillsStatus.textContent = 'Guardando habilidades...';
      skillsStatus.style.color = '#3b82f6';
    }

    const rawSkills = currentPortfolio.profile.skills_data || [];
    const skillsData = rawSkills
      .map((cat: any) => ({
        title: (cat.title || cat.category || '').trim(),
        skills: Array.isArray(cat.skills)
          ? cat.skills.map((s: string) => (typeof s === 'string' ? s.trim() : s)).filter(Boolean)
          : [],
      }))
      .filter((cat: any) => cat.title.length > 0 || cat.skills.length > 0);

    currentPortfolio.profile.skills_data = skillsData;

    if (supabase && isSupabaseConfigured) {
      try {
        const { error } = await supabase
          .from('profiles')
          .update({
            skills_data: skillsData,
            updated_at: new Date().toISOString(),
          })
          .eq('id', currentPortfolio.profile.id);

        if (error) throw error;
        if (skillsStatus) skillsStatus.textContent = 'Guardado';
        renderSkillsList(currentPortfolio);
        showToast('Habilidades actualizadas y guardadas con éxito', 'success');
      } catch (err: any) {
        showToast(`Error al guardar habilidades: ${err.message}`, 'error');
        if (skillsStatus) skillsStatus.textContent = 'Error';
      }
    } else {
      showToast('Habilidades guardadas en sesión', 'info');
      if (skillsStatus) skillsStatus.textContent = 'Guardado';
    }
  });

  // Inicializar
  checkAuthSession();
  if (currentPortfolio) {
    populateProfileForm(currentPortfolio);
  }
</script>

