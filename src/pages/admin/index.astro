---
/**
 * admin/index.astro — Panel de Administración (CMS) del Portfolio Builder.
 * Gestiona perfiles, proyectos, experiencias, servicios, plantillas y carga de imágenes a Supabase Storage.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isSupabaseConfigured, getAllProfiles, AVAILABLE_TEMPLATES } from '../../lib/supabase';

const profiles = await getAllProfiles();
---

<BaseLayout title="Panel de Control — Portfolio CMS" hideHeader={true} hideFooter={true}>
  <div class="admin-wrapper" id="admin-app">
    
    <!-- BARRA SUPERIOR ADMIN -->
    <header class="admin-topbar">
      <div class="container admin-topbar__inner">
        <div class="admin-topbar__brand">
          <a href="/" class="brand-link" title="Volver al Portal">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            <span>Folio Portal</span>
          </a>
          <span class="divider">/</span>
          <span class="current-section">Folio CMS</span>
        </div>

        <div class="admin-topbar__user">
          <div id="user-session-bar" class="user-session-bar" style="display: none;">
            <span class="user-email" id="display-user-email">usuario@correo.com</span>
            <button id="btn-logout" class="btn btn-sm btn-logout" title="Cerrar Sesión">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              <span>Salir</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="container admin-body">
      
      <!-- NOTIFICACIÓN DE ESTADO O VINCULACIÓN -->
      <div id="admin-notification" class="notice-box" style="display: none;"></div>

      <!-- SELECTOR DE PERFIL Y BOTÓN VER PORTAFOLIO -->
      <section class="profile-header-banner">
        <div class="profile-info-main">
          <div class="avatar-preview-wrap">
            <img id="avatar-preview-img" src="/images/avatar-placeholder.svg" alt="Avatar" class="avatar-preview" />
            <label for="input-avatar-file" class="avatar-upload-btn" title="Subir nueva foto">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            </label>
            <input type="file" id="input-avatar-file" accept="image/*" style="display: none;" />
          </div>
          <div>
            <div class="selector-row">
              <select id="select-profile-active" class="custom-select">
                {profiles.map((p) => (
                  <option value={p.slug}>{p.full_name} ({p.slug})</option>
                ))}
              </select>
            </div>
            <p class="profile-status-sub" id="profile-status-text">Cargando portafolio...</p>
          </div>
        </div>

        <div class="profile-actions-header">
          <button id="btn-quick-preview" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.45rem;">
            <span>👁️ Vista Previa</span>
          </button>
          <a id="btn-view-live" href="/benjie" target="_blank" class="btn btn-live">
            <span>Ver Portafolio en Vivo</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        </div>
      </section>

      <!-- TOAST NOTIFICATION CONTAINER -->
      <div id="toast-container" class="toast-container"></div>

      <!-- PESTAÑAS DE NAVEGACIÓN -->
      <div class="tabs-nav">
        <button class="tab-btn active" data-tab="tab-profile">Datos Personales</button>
        <button class="tab-btn" data-tab="tab-template">Plantilla Visual</button>
        <button class="tab-btn" data-tab="tab-projects">Proyectos</button>
        <button class="tab-btn" data-tab="tab-experiences">Experiencia</button>
        <button class="tab-btn" data-tab="tab-services">Servicios</button>
        <button class="tab-btn" data-tab="tab-skills">Habilidades</button>
        <button class="tab-btn" data-tab="tab-superadmin" id="btn-tab-superadmin" style="display: none;">🛡️ Super Admin</button>
      </div>

      <!-- TAB 1: DATOS PERSONALES -->
      <div class="tab-content active" id="tab-profile">
        <div class="card">
          <h2 class="card-title">Información Principal</h2>
          <p class="card-subtitle">Personaliza tus datos de contacto, presentación y biografía.</p>
          
          <form id="form-profile" class="admin-form">
            <div class="form-grid">
              <div class="form-group">
                <label for="prof-fullname">Nombre Completo *</label>
                <input type="text" id="prof-fullname" required placeholder="Ej: Benjie González" />
              </div>
              <div class="form-group">
                <label for="prof-headline">Título Profesional / Especialidad *</label>
                <input type="text" id="prof-headline" required placeholder="Ej: Ingeniero en TI" />
              </div>
            </div>

            <div class="form-group">
              <label for="prof-bio">Biografía / Presentación</label>
              <textarea id="prof-bio" rows="4" placeholder="Breve descripción sobre tu trayectoria y pasiones..."></textarea>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="prof-email">Correo Electrónico de Contacto</label>
                <input type="email" id="prof-email" placeholder="tu-correo@ejemplo.com" />
              </div>
              <div class="form-group">
                <label for="prof-phone">Teléfono / WhatsApp</label>
                <input type="text" id="prof-phone" placeholder="Ej: +593 99 999 9999" />
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="prof-location">Ubicación</label>
                <input type="text" id="prof-location" placeholder="Ciudad, País" />
              </div>
              <div class="form-group">
                <label for="prof-badge">Badge de Disponibilidad</label>
                <input type="text" id="prof-badge" placeholder="Disponible para proyectos" />
              </div>
            </div>

            <!-- ENLACES Y REDES SOCIALES (Fila compacta con selector desplegable) -->
            <div class="social-links-manager" style="margin: 1.5rem 0 1rem;">
              <label style="display: block; font-size: 0.95rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">
                Redes Sociales & Enlaces Profesionales
              </label>
              <p style="font-size: 0.85rem; color: #64748b; margin: 0 0 0.85rem 0;">
                Selecciona la red social, pega tu enlace y agrégala o actualízala.
              </p>

              <!-- Fila única de formulario -->
              <div class="social-add-row" style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
                <select id="social-select-platform" style="padding: 0.65rem 0.9rem; border-radius: 0.6rem; border: 1px solid #cbd5e1; font-weight: 600; color: #0f172a; background: #ffffff; min-width: 170px;">
                  <option value="github">🐙 GitHub</option>
                  <option value="linkedin">💼 LinkedIn</option>
                  <option value="instagram">📸 Instagram</option>
                  <option value="behance">🎨 Behance</option>
                  <option value="twitter">🐦 X (Twitter)</option>
                  <option value="website">🌐 Sitio Web</option>
                </select>
                <input 
                  type="url" 
                  id="social-input-url" 
                  placeholder="https://..." 
                  style="flex: 1; min-width: 220px; padding: 0.65rem 0.9rem; border-radius: 0.6rem; border: 1px solid #cbd5e1; font-size: 0.925rem;" 
                />
                <button type="button" id="btn-add-social-link" class="btn btn-outline" style="padding: 0.65rem 1.1rem; white-space: nowrap; font-weight: 600;">
                  + Agregar Red
                </button>
              </div>

              <!-- Lista de redes activas agregadas -->
              <div id="social-active-list" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.85rem;">
                <!-- Rellenado dinámicamente con tags/pills de redes configuradas -->
              </div>

              <!-- Inputs ocultos para mantener compatibilidad y persistencia directa -->
              <input type="hidden" id="prof-github" />
              <input type="hidden" id="prof-linkedin" />
              <input type="hidden" id="prof-instagram" />
              <input type="hidden" id="prof-behance" />
              <input type="hidden" id="prof-twitter" />
              <input type="hidden" id="prof-website" />
            </div>

            <!-- PREFERENCIA VISUAL (Avatar URL oculto del usuario, solo color de acento visible) -->
            <input type="hidden" id="prof-avatar" />
            <div class="form-group" style="margin-top: 1rem;">
              <label for="prof-theme" style="font-weight: 600;">Color de Acento del Portafolio</label>
              <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.35rem;">
                <input type="color" id="prof-theme" value="#2563eb" class="color-picker-input" />
                <span style="font-size: 0.85rem; color: #64748b;">Tono principal para botones, títulos y efectos glow.</span>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" id="btn-save-profile">
                Guardar Cambios de Perfil
              </button>
              <span class="save-indicator" id="profile-save-status"></span>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB 2: PLANTILLA VISUAL -->
      <!-- TAB 2: PLANTILLA VISUAL Y MODO -->
      <div class="tab-content" id="tab-template">
        <div class="card">
          <h2 class="card-title">Selección de Plantilla Visual</h2>
          <p class="card-subtitle">Alterna entre los diseños predefinidos para cambiar la personalidad estética de tu portafolio.</p>

          <div class="templates-admin-grid">
            {AVAILABLE_TEMPLATES.map((tmpl) => (
              <div class="tmpl-select-card" data-tmpl-id={tmpl.id}>
                <div class="tmpl-preview" style={`background: ${tmpl.previewBg};`}>
                  <span class="tmpl-badge-tag">{tmpl.badge}</span>
                </div>
                <div class="tmpl-body">
                  <h3 class="tmpl-title">{tmpl.name}</h3>
                  <p class="tmpl-cat">{tmpl.category}</p>
                  <p class="tmpl-desc">{tmpl.description}</p>
                  <button type="button" class="btn btn-sm btn-outline btn-activate-tmpl" data-set-tmpl={tmpl.id}>
                    Activar esta plantilla
                  </button>
                </div>
              </div>
            ))}
          </div>

          <!-- SELECCIÓN DE MODO OSCURO / CLARO -->
          <div class="admin-theme-mode-section">
            <h3 class="admin-section-subtitle">Preferencia de Modo Visual (Tema)</h3>
            <p class="card-subtitle">Define si tu portafolio público se presentará en modo oscuro o modo claro para tus visitantes.</p>

            <div class="admin-modes-grid">
              <button type="button" class="admin-mode-card" id="btn-mode-dark" data-set-mode="dark">
                <span class="admin-mode-icon">🌙</span>
                <div class="admin-mode-info">
                  <strong class="admin-mode-title">Modo Oscuro</strong>
                  <span class="admin-mode-desc">Fondo profundo elegante, acentos vibrantes y alto impacto visual.</span>
                </div>
                <span class="admin-mode-pill" id="badge-mode-dark">Activo</span>
              </button>

              <button type="button" class="admin-mode-card" id="btn-mode-light" data-set-mode="light">
                <span class="admin-mode-icon">☀️</span>
                <div class="admin-mode-info">
                  <strong class="admin-mode-title">Modo Claro</strong>
                  <span class="admin-mode-desc">Fondo blanco pulcro, estilo diáfano y máxima legibilidad editorial.</span>
                </div>
                <span class="admin-mode-pill" id="badge-mode-light">Activar</span>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- TAB 3: PROYECTOS -->
      <div class="tab-content" id="tab-projects">
        <div class="card">
          <div class="card-header-flex">
            <div>
              <h2 class="card-title">Proyectos del Portafolio</h2>
              <p class="card-subtitle">Administra los trabajos destacados que se mostrarán en la vitrina.</p>
            </div>
            <button class="btn btn-primary" id="btn-open-project-modal">+ Nuevo Proyecto</button>
          </div>

          <div class="items-list" id="projects-list-container">
            <p class="empty-text">Cargando proyectos...</p>
          </div>
        </div>
      </div>

      <!-- TAB 4: EXPERIENCIAS -->
      <div class="tab-content" id="tab-experiences">
        <div class="card">
          <div class="card-header-flex">
            <div>
              <h2 class="card-title">Trayectoria y Experiencia</h2>
              <p class="card-subtitle">Cargos, empresas y periodos laborales.</p>
            </div>
            <button class="btn btn-primary" id="btn-add-exp">+ Añadir Experiencia</button>
          </div>

          <div class="items-list" id="exp-list-container">
            <p class="empty-text">Cargando experiencia...</p>
          </div>
        </div>
      </div>

      <!-- TAB 5: SERVICIOS -->
      <div class="tab-content" id="tab-services">
        <div class="card">
          <div class="card-header-flex">
            <div>
              <h2 class="card-title">Servicios y Especialidades</h2>
              <p class="card-subtitle">Soluciones profesionales que ofreces a tus clientes.</p>
            </div>
            <button class="btn btn-primary" id="btn-add-srv">+ Añadir Servicio</button>
          </div>

          <div class="items-list" id="srv-list-container">
            <p class="empty-text">Cargando servicios...</p>
          </div>
        </div>
      </div>

      <!-- TAB 6: HABILIDADES (CATEGORÍAS Y STACK) -->
      <div class="tab-content" id="tab-skills">
        <div class="card">
          <div class="card-header-flex">
            <div>
              <h2 class="card-title">Categorías de Habilidades & Stack Tecnológico</h2>
              <p class="card-subtitle">Personaliza tus grupos de destrezas (ej: Frontend, Backend, UI/UX, Cloud) y las herramientas de cada una.</p>
            </div>
            <button class="btn btn-primary" id="btn-add-skill-category">+ Nueva Categoría</button>
          </div>

          <div class="items-list" id="skills-list-container">
            <p class="empty-text">Cargando categorías de habilidades...</p>
          </div>

          <div class="form-actions" style="margin-top: 2rem;">
            <button type="button" class="btn btn-primary" id="btn-save-skills">
              Guardar Cambios de Habilidades
            </button>
            <span class="save-indicator" id="skills-save-status"></span>
          </div>
        </div>
      </div>

      <!-- TAB 7: SUPER ADMIN -->
      <div class="tab-content" id="tab-superadmin">
        <div class="card">
          <div class="card-header-flex">
            <div>
              <h2 class="card-title">Panel de Super Administrador</h2>
              <p class="card-subtitle">Métricas en vivo, control de portafolios y gestión de usuarios registrados.</p>
            </div>
            <button class="btn btn-sm btn-outline" id="btn-refresh-admin-metrics">🔄 Actualizar Métricas</button>
          </div>

          <!-- TARJETAS DE MÉTRICAS -->
          <div class="admin-metrics-grid">
            <div class="metric-card">
              <span class="metric-num" id="metric-total-portfolios">0</span>
              <span class="metric-label">Portafolios Registrados</span>
            </div>
            <div class="metric-card">
              <span class="metric-num" id="metric-total-projects">0</span>
              <span class="metric-label">Proyectos Publicados</span>
            </div>
            <div class="metric-card">
              <span class="metric-num" id="metric-active-users">0</span>
              <span class="metric-label">Usuarios Autenticados</span>
            </div>
          </div>

          <!-- TABLA DE USUARIOS Y PORTAFOLIOS -->
          <div style="margin-top: 2rem;">
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Directorio Global de Portafolios</h3>
            <div class="table-responsive">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Enlace (Slug)</th>
                    <th>Plantilla</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody id="admin-users-tbody">
                  <tr>
                    <td colspan="5" style="text-align: center; color: #64748b; padding: 2rem;">Cargando usuarios...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- MODAL PARA AGREGAR / EDITAR PROYECTO -->
  <div id="project-modal" class="modal-overlay" style="display: none;">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 id="modal-project-title">Nuevo Proyecto</h3>
        <button id="modal-project-close" class="modal-close">&times;</button>
      </div>
      <form id="project-form" class="modal-body">
        <div class="form-group">
          <label for="proj-title">Título del Proyecto *</label>
          <input type="text" id="proj-title" required placeholder="Ej: Rediseño de Plataforma Web" />
        </div>
        <div class="form-group">
          <label for="proj-desc">Descripción Breve</label>
          <textarea id="proj-desc" rows="3" placeholder="Objetivo, tecnologías aplicadas y solución entregada..."></textarea>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label for="proj-category">Categoría</label>
            <input type="text" id="proj-category" placeholder="Ej: Web, TI, Branding, Video" />
          </div>
          <div class="form-group">
            <label for="proj-tags">Etiquetas / Tags (separados por coma)</label>
            <input type="text" id="proj-tags" placeholder="Astro, PostgreSQL, Docker" />
          </div>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label for="proj-live">Enlace en Vivo (Demo / Web)</label>
            <input type="url" id="proj-live" placeholder="https://ejemplo.com" />
          </div>
          <div class="form-group">
            <label for="proj-repo">Enlace Repositorio (GitHub)</label>
            <input type="url" id="proj-repo" placeholder="https://github.com/..." />
          </div>
        </div>

        <!-- SUBIDA DE IMAGEN -->
        <div class="form-group">
          <label>Imagen del Proyecto</label>
          <div class="upload-image-box">
            <input type="file" id="proj-image-file" accept="image/*" class="sr-only" />
            <div class="upload-actions">
              <label for="proj-image-file" class="btn btn-sm btn-outline">
                📁 Seleccionar Imagen de mi Equipo
              </label>
              <span id="proj-file-status" class="file-status-text">Ningún archivo subido</span>
            </div>
            <input type="text" id="proj-image-url" placeholder="O pega la URL directa de la imagen" style="margin-top: 0.5rem;" />
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" id="btn-cancel-project" class="btn btn-outline">Cancelar</button>
          <button type="submit" id="btn-save-project" class="btn btn-primary">Guardar Proyecto</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL VISTA PREVIA RÁPIDA -->
  <div id="preview-modal" class="modal-overlay" style="display: none;">
    <div class="modal-dialog preview-dialog">
      <div class="modal-header">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <h3 style="margin: 0;">Vista Previa del Portafolio</h3>
          <div class="device-toggle-group">
            <button type="button" class="device-btn active" data-device="desktop">💻 Desktop</button>
            <button type="button" class="device-btn" data-device="mobile">📱 Móvil</button>
          </div>
        </div>
        <button id="modal-preview-close" class="modal-close">&times;</button>
      </div>
      <div class="modal-body preview-modal-body">
        <iframe id="preview-iframe" src="/benjie" class="preview-iframe"></iframe>
      </div>
    </div>
  </div>

  <!-- MODAL HERRAMIENTA DE RECORTE Y OPTIMIZACIÓN (CROPPER TOOL) -->
  <div id="crop-modal" class="modal-overlay" style="display: none; z-index: 1100;">
    <div class="modal-dialog" style="max-width: 520px;">
      <div class="modal-header">
        <h3 id="crop-modal-title">Ajustar y Optimizar Imagen</h3>
        <button type="button" id="crop-modal-close" class="modal-close">&times;</button>
      </div>
      <div class="modal-body" style="text-align: center;">
        <p style="font-size: 0.875rem; color: #64748b; margin-top: 0; margin-bottom: 1rem;">
          Arrastra para centrar o ajusta el zoom. La imagen se optimizará automáticamente en formato WebP de alta velocidad.
        </p>

        <!-- Canvas de recorte -->
        <div class="crop-canvas-wrapper" style="position: relative; display: inline-block; background: #0f172a; border-radius: 1rem; overflow: hidden; box-shadow: inset 0 2px 8px rgba(0,0,0,0.5); cursor: grab;">
          <canvas id="crop-canvas" width="400" height="400" style="display: block; max-width: 100%; height: auto;"></canvas>
          <div id="crop-frame-guide" class="crop-guide-circle" style="position: absolute; inset: 20px; border: 2px dashed rgba(255,255,255,0.7); border-radius: 50%; pointer-events: none; box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.45);"></div>
        </div>

        <!-- Controles de Zoom -->
        <div style="display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.25rem;">
          <span style="font-size: 0.875rem; color: #64748b;">Zoom:</span>
          <input type="range" id="crop-zoom-range" min="1" max="3" step="0.05" value="1" style="width: 220px; accent-color: #2563eb;" />
          <button type="button" class="btn btn-sm btn-outline" id="crop-btn-reset">Reiniciar</button>
        </div>

        <div id="crop-file-info" style="font-size: 0.8rem; color: #64748b; margin-top: 0.75rem;">
          Tamaño original: <span id="crop-orig-size">0 KB</span>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="crop-btn-cancel" class="btn btn-outline">Cancelar</button>
        <button type="button" id="crop-btn-confirm" class="btn btn-primary">
          <span id="crop-btn-text">Optimizar y Subir</span>
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { fallbackPortfolios, supabase, isSupabaseConfigured, defaultSkillsBySlug } from '../../lib/supabase';
  import { uploadMediaFile } from '../../lib/storage';
  import type { FullPortfolio, Project } from '../../lib/types';

  // Elementos DOM
  const selectProfile = document.getElementById('select-profile-active') as HTMLSelectElement;
  const btnViewLive = document.getElementById('btn-view-live') as HTMLAnchorElement;
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');
  const userSessionBar = document.getElementById('user-session-bar');
  const displayUserEmail = document.getElementById('display-user-email');
  const btnLogout = document.getElementById('btn-logout');
