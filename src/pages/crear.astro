---
/**
 * crear.astro — Onboarding y Generador de Portafolios Online (Portfolio Builder).
 * Permite a cualquier nuevo usuario crear su cuenta, elegir su plantilla y publicar su portafolio.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { AVAILABLE_TEMPLATES, isSupabaseConfigured } from '../lib/supabase';
---

<BaseLayout
  title="Crear mi Portafolio Gratis — Folio"
  description="Genera tu portafolio web profesional en menos de 1 minuto con plantillas modernas y administración completa."
  hideHeader={true}
  hideFooter={true}
>
  <div class="builder-page">
    <div class="builder-container">
      
      <!-- NAVEGACIÓN SUPERIOR -->
      <header class="builder-nav">
        <a href="/" class="nav-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span>Volver a Folio</span>
        </a>
        <div class="nav-login">
          <span>¿Ya tienes cuenta?</span>
          <a href="/login" class="link-login">Inicia Sesión</a>
        </div>
      </header>

      <!-- ENCABEZADO PRINCIPAL -->
      <div class="builder-hero">
        <span class="badge-pill">✨ Folio Builder</span>
        <h1 class="hero-title">Crea tu Portafolio Profesional en 1 Minuto</h1>
        <p class="hero-desc">
          Elige una plantilla diseñada para impresionar, personaliza tu información y obtén tu enlace público listo para compartir con clientes y reclutadores.
        </p>
      </div>

      <!-- ALERTA DE MENSAJES -->
      <div id="status-alert" class="status-alert" style="display: none;"></div>

      <!-- FORMULARIO BUILDER -->
      <form id="portfolio-builder-form" class="builder-form">
        
        <!-- PASO 1: DATOS PERSONALES Y SLUG -->
        <section class="form-card">
          <div class="card-step-header">
            <span class="step-number">1</span>
            <div>
              <h2 class="step-title">Tu Información Profesional</h2>
              <p class="step-subtitle">Define tu identidad pública y el enlace web de tu portafolio.</p>
            </div>
          </div>

          <div class="inputs-grid">
            <div class="form-group">
              <label for="fullName">Nombre Completo *</label>
              <input 
                type="text" 
                id="fullName" 
                name="fullName" 
                placeholder="Ej: Carlos Mendoza" 
                required 
              />
            </div>

            <div class="form-group">
              <label for="headline">Especialidad o Rol Principal *</label>
              <input 
                type="text" 
                id="headline" 
                name="headline" 
                placeholder="Ej: Full Stack Developer & Cloud Engineer" 
                required 
              />
            </div>

            <div class="form-group full-width">
              <label for="slug">Enlace Personal Único (Slug) *</label>
              <div class="slug-input-wrapper">
                <span class="slug-prefix">portafolio.com/</span>
                <input 
                  type="text" 
                  id="slug" 
                  name="slug" 
                  placeholder="carlos-mendoza" 
                  pattern="[a-z0-9_-]+" 
                  required 
                />
              </div>
              <small class="help-text">Solo minúsculas, números y guiones. Así accederán a tu portafolio público.</small>
            </div>
          </div>
        </section>

        <!-- PASO 2: SELECCIÓN DE PLANTILLA Y PREFERENCIA DE ESTILO -->
        <section class="form-card">
          <div class="card-step-header">
            <span class="step-number">2</span>
            <div>
              <h2 class="step-title">Plantilla y Preferencia de Modo Visual</h2>
              <p class="step-subtitle">Elige el diseño y el modo de color (claro u oscuro). Verás un preview instantáneo antes de generarlo.</p>
            </div>
          </div>

          <!-- SELECCIÓN DE PLANTILLA -->
          <div class="step-subsection">
            <h3 class="subsection-title">1. Elige tu Plantilla de Diseño</h3>
            <div class="templates-grid">
              {AVAILABLE_TEMPLATES.map((tmpl, idx) => (
                <label class={`template-card ${idx === 0 ? 'selected' : ''}`} data-template-id={tmpl.id} data-accent={tmpl.recommendedColor} data-tmpl-name={tmpl.name}>
                  <input 
                    type="radio" 
                    name="templateId" 
                    value={tmpl.id} 
                    checked={idx === 0} 
                    class="sr-only"
                  />
                  <div class="template-preview" style={`background: ${tmpl.previewBg};`}>
                    <div class="mockup-window">
                      <div class="mockup-dots">
                        <span></span><span></span><span></span>
                      </div>
                      <div class="mockup-content">
                        <div class="mockup-bar" style={`background: ${tmpl.recommendedColor}; width: 60%;`}></div>
                        <div class="mockup-line" style="width: 80%;"></div>
                        <div class="mockup-line" style="width: 45%;"></div>
                      </div>
                    </div>
                  </div>
                  <div class="template-details">
                    <div class="template-header">
                      <h4 class="template-name">{tmpl.name}</h4>
                      <span class="template-badge">{tmpl.badge}</span>
                    </div>
                    <p class="template-desc">{tmpl.description}</p>
                    <div class="template-category">
                      <span class="tag">{tmpl.category}</span>
                    </div>
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- PREFERENCIA DE MODO (OSCURO O CLARO) -->
          <div class="step-subsection" style="margin-top: 2rem;">
            <div class="subsection-header-row">
              <div>
                <h3 class="subsection-title">2. Preferencia de Modo de Color</h3>
                <p class="subsection-desc">Define la apariencia predeterminada que verán tus visitantes al entrar a tu portafolio.</p>
              </div>
            </div>
            
            <div class="theme-modes-grid">
              <label class="theme-mode-card selected" data-mode="dark">
                <input type="radio" name="themeMode" value="dark" checked class="sr-only" />
                <div class="theme-mode-badge-icon">🌙</div>
                <div class="theme-mode-body">
                  <div class="theme-mode-heading">
                    <span class="theme-mode-name">Modo Oscuro</span>
                    <span class="mode-pill-tag">Recomendado Tech</span>
                  </div>
                  <p class="theme-mode-text">Estética premium con fondos oscuros profundos y acentos vibrantes de alto contraste.</p>
                </div>
                <div class="theme-mode-radio-visual">
                  <div class="radio-dot"></div>
                </div>
              </label>

              <label class="theme-mode-card" data-mode="light">
                <input type="radio" name="themeMode" value="light" class="sr-only" />
                <div class="theme-mode-badge-icon">☀️</div>
                <div class="theme-mode-body">
                  <div class="theme-mode-heading">
                    <span class="theme-mode-name">Modo Claro</span>
                    <span class="mode-pill-tag light-tag">Limpio & Minimal</span>
                  </div>
                  <p class="theme-mode-text">Estética luminosa y editorial sobre fondos blancos pulcros, ideal para creativos y marketing.</p>
                </div>
                <div class="theme-mode-radio-visual">
                  <div class="radio-dot"></div>
                </div>
              </label>
            </div>
          </div>

          <!-- VISTA PREVIA EN MINIATURA EN VIVO (MOCKUP PREVIEW) -->
          <div class="live-preview-box">
            <div class="live-preview-bar">
              <div class="live-preview-title-wrap">
                <span class="pulse-indicator"></span>
                <span class="preview-title-text">Vista Previa en Vivo de tu Portafolio</span>
              </div>
              <span class="preview-badge" id="preview-status-pill">Tech Minimal • Modo Oscuro</span>
            </div>

            <div class="mini-browser-container preview-mode-dark" id="mini-browser-preview" style="--mini-accent: #2563eb;">
              <!-- Barra de Navegador Miniatura -->
              <div class="mini-browser-top">
                <div class="mini-dots-group">
                  <span class="dot dot-red"></span>
                  <span class="dot dot-yellow"></span>
                  <span class="dot dot-green"></span>
                </div>
                <div class="mini-address-pill">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <span id="mini-url-text">folio.dev/tu-enlace</span>
                </div>
              </div>

              <!-- Ventana del Portafolio Miniatura -->
              <div class="mini-viewport-content">
                <div class="mini-hero-block">
                  <div class="mini-avatar-circle" id="mini-avatar-initials">TU</div>
                  <div class="mini-status-chip">
                    <span class="mini-dot"></span>
                    <span>Disponible para proyectos</span>
                  </div>
                  <div class="mini-full-name" id="mini-name-text">Tu Nombre Completo</div>
                  <div class="mini-role-title" id="mini-headline-text">Tu Especialidad o Rol Profesional</div>
                  <div class="mini-cta-btn-wrap">
                    <div class="mini-button-accent">
                      <span>Conversar por WhatsApp</span>
                    </div>
                  </div>
                </div>

                <!-- Mini Vitrina de Proyectos -->
                <div class="mini-projects-row">
                  <div class="mini-project-item">
                    <div class="mini-thumb-area">
                      <div class="mini-thumb-decor"></div>
                    </div>
                    <div class="mini-info-area">
                      <div class="mini-bar-title"></div>
                      <div class="mini-bar-subtitle"></div>
                    </div>
                  </div>
                  <div class="mini-project-item">
                    <div class="mini-thumb-area">
                      <div class="mini-thumb-decor"></div>
                    </div>
                    <div class="mini-info-area">
                      <div class="mini-bar-title"></div>
                      <div class="mini-bar-subtitle"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <p class="preview-footnote">
              * Podrás agregar imágenes reales, proyectos completos y redes sociales inmediatamente después desde tu panel administrativo.
            </p>
          </div>
        </section>

        <!-- PASO 3: CUENTA DE ACCESO -->
        <section class="form-card">
          <div class="card-step-header">
            <span class="step-number">3</span>
            <div>
              <h2 class="step-title">Crea tu Cuenta de Acceso</h2>
              <p class="step-subtitle">Con estos datos podrás entrar a tu panel administrativo para editar tu contenido y subir imágenes.</p>
            </div>
          </div>

          <div class="inputs-grid">
            <div class="form-group">
              <label for="email">Correo Electrónico *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="tu@correo.com" 
                required 
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="password">Contraseña Segura *</label>
              <input 
                type="password" 
                id="password" 
                name="password" 
                placeholder="Mínimo 6 caracteres" 
                minlength="6" 
                required 
                autocomplete="new-password"
              />
            </div>
          </div>
        </section>

        <!-- BOTÓN DE ENVÍO -->
        <div class="form-actions-bar">
          <button type="submit" id="btn-generate" class="btn-generate">
            <span class="btn-text">🚀 Generar y Publicar mi Portafolio</span>
            <span class="btn-spinner" style="display: none;">
              <svg class="spinner" viewBox="0 0 50 50">
                <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
              </svg>
              <span>Configurando tu portafolio...</span>
            </span>
          </button>
          <p class="terms-note">
            Al registrarte tendrás acceso a tu panel de edición gratuito sin costo de mantenimiento.
          </p>
        </div>

      </form>

    </div>
  </div>
</BaseLayout>

<script>
  import { supabase, isSupabaseConfigured, createNewPortfolio } from '../lib/supabase';

  // Referencias de elementos para el Mini Mockup en Vivo
  const miniBrowserPreview = document.getElementById('mini-browser-preview') as HTMLElement;
  const previewStatusPill = document.getElementById('preview-status-pill') as HTMLElement;
  const miniUrlText = document.getElementById('mini-url-text') as HTMLElement;
  const miniAvatarInitials = document.getElementById('mini-avatar-initials') as HTMLElement;
  const miniNameText = document.getElementById('mini-name-text') as HTMLElement;
  const miniHeadlineText = document.getElementById('mini-headline-text') as HTMLElement;

  let currentTemplateName = 'Tech Minimal';
  let currentTemplateAccent = '#2563eb';
  let currentMode = 'dark';

  function updatePreviewStatus() {
    if (previewStatusPill) {
      const modeLabel = currentMode === 'dark' ? 'Modo Oscuro' : 'Modo Claro';
      previewStatusPill.textContent = `${currentTemplateName} • ${modeLabel}`;
    }
  }

  // 1. Manejo de selección visual de plantillas
  const templateCards = document.querySelectorAll('.template-card');
  templateCards.forEach((card) => {
    card.addEventListener('click', () => {
      templateCards.forEach((c) => c.classList.remove('selected'));
      card.classList.add('selected');
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio) radio.checked = true;

      const cardEl = card as HTMLElement;
      currentTemplateName = cardEl.getAttribute('data-tmpl-name') || 'Tech Minimal';
      currentTemplateAccent = cardEl.getAttribute('data-accent') || '#2563eb';

      if (miniBrowserPreview) {
        miniBrowserPreview.style.setProperty('--mini-accent', currentTemplateAccent);
      }
      updatePreviewStatus();
    });
  });

  // 2. Manejo de selección de Modo Oscuro / Claro
  const themeModeCards = document.querySelectorAll('.theme-mode-card');
  themeModeCards.forEach((card) => {
    card.addEventListener('click', () => {
      themeModeCards.forEach((c) => c.classList.remove('selected'));
      card.classList.add('selected');
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio) radio.checked = true;

      const mode = (card as HTMLElement).getAttribute('data-mode') || 'dark';
      currentMode = mode;

      if (miniBrowserPreview) {
        if (mode === 'dark') {
          miniBrowserPreview.classList.remove('preview-mode-light');
          miniBrowserPreview.classList.add('preview-mode-dark');
        } else {
          miniBrowserPreview.classList.remove('preview-mode-dark');
          miniBrowserPreview.classList.add('preview-mode-light');
        }
      }
      updatePreviewStatus();
    });
  });

  // 3. Reactividad en tiempo real de inputs (nombre, headline, slug)
  const fullNameInput = document.getElementById('fullName') as HTMLInputElement;
  const headlineInput = document.getElementById('headline') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  let userManuallyEditedSlug = false;

  function updateInitials(name: string) {
    if (!miniAvatarInitials) return;
    const clean = name.trim();
    if (!clean) {
      miniAvatarInitials.textContent = 'TU';
      return;
    }
    const parts = clean.split(' ').filter(Boolean);
    if (parts.length >= 2) {
      miniAvatarInitials.textContent = (parts[0][0] + parts[1][0]).toUpperCase();
    } else {
      miniAvatarInitials.textContent = clean.slice(0, 2).toUpperCase();
    }
  }

  fullNameInput?.addEventListener('input', () => {
    const val = fullNameInput.value.trim();
    if (miniNameText) {
      miniNameText.textContent = val || 'Tu Nombre Completo';
    }
    updateInitials(val);

    if (!userManuallyEditedSlug && slugInput) {
      slugInput.value = fullNameInput.value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      if (miniUrlText) {
        miniUrlText.textContent = `folio.dev/${slugInput.value || 'tu-enlace'}`;
      }
    }
  });

  headlineInput?.addEventListener('input', () => {
    if (miniHeadlineText) {
      miniHeadlineText.textContent = headlineInput.value.trim() || 'Tu Especialidad o Rol Profesional';
    }
  });

  slugInput?.addEventListener('input', () => {
    userManuallyEditedSlug = true;
    slugInput.value = slugInput.value.toLowerCase().replace(/[^a-z0-9_-]/g, '');
    if (miniUrlText) {
      miniUrlText.textContent = `folio.dev/${slugInput.value || 'tu-enlace'}`;
    }
  });

  // 4. Envío del formulario
  const form = document.getElementById('portfolio-builder-form') as HTMLFormElement;
  const alertBox = document.getElementById('status-alert') as HTMLDivElement;
  const btnSubmit = document.getElementById('btn-generate') as HTMLButtonElement;
  const btnText = btnSubmit?.querySelector('.btn-text') as HTMLElement;
  const btnSpinner = btnSubmit?.querySelector('.btn-spinner') as HTMLElement;

  function showAlert(message: string, isError: boolean = true) {
    if (!alertBox) return;
    alertBox.textContent = message;
    alertBox.className = `status-alert ${isError ? 'status-alert--error' : 'status-alert--success'}`;
    alertBox.style.display = 'block';
    alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function setLoading(loading: boolean) {
    if (!btnSubmit) return;
    btnSubmit.disabled = loading;
    if (btnText) btnText.style.display = loading ? 'none' : 'inline';
    if (btnSpinner) btnSpinner.style.display = loading ? 'inline-flex' : 'none';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!supabase || !isSupabaseConfigured) {
      showAlert('Supabase no está configurado en las variables de entorno.');
      return;
    }

    const fullName = fullNameInput.value.trim();
    const headline = headlineInput.value.trim();
    const slug = slugInput.value.trim().toLowerCase();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const selectedTemplate = (document.querySelector('input[name="templateId"]:checked') as HTMLInputElement)?.value || 'tech-minimal';
    const selectedThemeMode = (document.querySelector('input[name="themeMode"]:checked') as HTMLInputElement)?.value || 'dark';

    if (!fullName || !headline || !slug || !email || !password) {
      showAlert('Por favor llena todos los campos obligatorios.');
      return;
    }

    if (password.length < 6) {
      showAlert('La contraseña debe tener al menos 6 caracteres.');
      return;
    }

    setLoading(true);
    if (alertBox) alertBox.style.display = 'none';

    try {
      // 1. Registrar usuario en Supabase Auth
      const { data: authData, error: authError } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: {
            full_name: fullName,
            slug: slug,
          }
        }
      });

      if (authError) {
        showAlert(`Error al registrar usuario: ${authError.message}`);
        setLoading(false);
        return;
      }

      const userId = authData.user?.id;
      if (!userId) {
        showAlert('No se pudo obtener el identificador de usuario. Intenta de nuevo.');
        setLoading(false);
        return;
      }

      // 2. Crear portafolio base (perfil con tema configurado, proyectos y servicios iniciales)
      const { profile, error: portError } = await createNewPortfolio({
        userId,
        slug,
        fullName,
        headline,
        email,
        templateId: selectedTemplate,
        themeMode: selectedThemeMode,
      });

      if (portError) {
        showAlert(`Error al inicializar portafolio: ${portError}`);
        setLoading(false);
        return;
      }

      // 3. Éxito: Guardar slug en localStorage y redirigir al panel para continuar editando
      localStorage.setItem('active_portfolio_slug', slug);
      showAlert(`¡Portafolio de ${fullName} creado exitosamente! Redirigiendo a tu panel para que agregues tus proyectos, imágenes y redes...`, false);

      setTimeout(() => {
        window.location.href = '/admin';
      }, 1400);

    } catch (err: any) {
      showAlert(`Ocurrió un error inesperado: ${err?.message || err}`);
      setLoading(false);
    }
  });
</script>

<style>
  .builder-page {
    min-height: 100vh;
    background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 100% 50%, rgba(236, 72, 153, 0.08) 0%, transparent 40%),
                #090d16;
    color: #f8fafc;
    padding: 2rem 1.5rem 5rem 1.5rem;
    font-family: inherit;
  }

  .builder-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  /* BARRA SUPERIOR */
  .builder-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .nav-back:hover {
    color: #ffffff;
  }

  .nav-login {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: #94a3b8;
  }

  .link-login {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 600;
  }
  .link-login:hover {
    text-decoration: underline;
  }

  /* HERO */
  .builder-hero {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .badge-pill {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    background: rgba(37, 99, 235, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #60a5fa;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 1rem 0;
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.85rem;
    }
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* ALERTA */
  .status-alert {
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .status-alert--error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #fca5a5;
  }

  .status-alert--success {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: #86efac;
  }

  /* FORMULARIO */
  .builder-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 1.25rem;
    padding: 2.25rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .card-step-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .step-number {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: #2563eb;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
