---
/**
 * ProjectCard.astro — Tarjeta de proyecto.
 *
 * Muestra la imagen, la categoría, el título, el resumen y las etiquetas.
 * Toda la tarjeta es un enlace, así que es fácil de pulsar en el móvil.
 *
 * Las imágenes se importan dinámicamente desde src/assets/proyectos/ usando el
 * campo `image` de cada proyecto en src/data/site.ts. Astro las optimiza a
 * WebP y AVIF y genera varios tamaños automáticamente.
 */
import { Image } from 'astro:assets';
import type { Project } from '../data/site';
import Icon from './Icon.astro';

export interface Props {
  project: Project;
  /** 'wide' ocupa dos columnas en escritorio, para romper la cuadrícula. */
  size?: 'normal' | 'wide';
  /** Retardo de la animación de entrada, en milisegundos. */
  delay?: number;
}

const { project, size = 'normal', delay = 0 } = Astro.props;

// Importa todas las imágenes de la carpeta una sola vez.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/proyectos/*', { eager: true });

const key = `../assets/proyectos/${project.image}`;
const image = images[key]?.default;

if (!image) {
  // Aviso claro en la consola del build si el nombre del archivo no coincide.
  console.warn(
    `[ProjectCard] No se encontró la imagen "${project.image}" del proyecto "${project.slug}". ` +
      `Revisa el campo "image" en src/data/site.ts y los archivos de src/assets/proyectos/.`
  );
}
---

<article
  class:list={['pcard', `pcard--${project.accent}`, size === 'wide' && 'pcard--wide']}
  data-reveal
  style={`--reveal-delay:${delay}ms`}
>
  <a class="pcard__link" href={`/portafolio/${project.slug}`}>
    <div class="pcard__media">
      {
        image ? (
          <Image
            src={image}
            alt={`${project.title} — ${project.category}`}
            widths={[400, 700, 1000]}
            sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 46vw, 34vw"
            loading="lazy"
            decoding="async"
            class="pcard__img"
          />
        ) : (
          <div class="pcard__placeholder" aria-hidden="true" />
        )
      }

      <!-- Velo de color que aparece al pasar el cursor -->
      <span class="pcard__overlay" aria-hidden="true"></span>

      <!-- Botón circular "ver proyecto" -->
      <span class="pcard__cta" aria-hidden="true">
        <Icon name="arrow-up-right" size={20} />
      </span>

      <span class="pcard__badge">{project.category}</span>
    </div>

    <div class="pcard__body">
      <div class="pcard__meta">
        <span class="pcard__year">{project.year}</span>
        <span class="pcard__dot" aria-hidden="true"></span>
        <span class="pcard__client">{project.client}</span>
      </div>

      <h3 class="pcard__title">{project.title}</h3>
      <p class="pcard__summary">{project.summary}</p>

      <ul class="pcard__tags">
        {
          project.tags.slice(0, 3).map((tag) => (
            <li>{tag}</li>
          ))
        }
        {project.tags.length > 3 && <li class="pcard__more">+{project.tags.length - 3}</li>}
      </ul>
    </div>
  </a>
</article>

<style>
  /* Cada acento define su propio color, reutilizado en toda la tarjeta */
  .pcard--pink {
    --accent: var(--c-pink);
  }
  .pcard--violet {
    --accent: var(--c-violet);
  }
  .pcard--cyan {
    --accent: var(--c-cyan);
  }
  .pcard--tangerine {
    --accent: var(--c-tangerine);
  }
  .pcard--yellow {
    --accent: var(--c-yellow);
  }
  .pcard--lime {
    --accent: var(--c-lime);
  }

  .pcard {
    --accent: var(--c-violet);

    position: relative;
    display: flex;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .pcard:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 22px 60px -20px color-mix(in srgb, var(--accent) 58%, transparent);
    transform: translateY(-7px);
  }

  .pcard__link {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* ------------------------------------------------------------- Imagen */

  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 40%, var(--c-cyan)));
  }

  .pcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease), filter 0.5s var(--ease);
  }

  .pcard:hover .pcard__img {
    transform: scale(1.06);
  }

  .pcard__placeholder {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      rgb(255 255 255 / 22%) 0 14px,
      rgb(255 255 255 / 8%) 14px 28px
    );
  }

  /* Velo de color al pasar el cursor */
  .pcard__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 55%, transparent) 0%,
      transparent 45%,
      color-mix(in srgb, var(--c-ink) 62%, transparent) 100%
    );
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .pcard:hover .pcard__overlay {
    opacity: 1;
  }

  /* Botón circular con flecha */
  .pcard__cta {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    color: var(--c-ink);
    background: var(--c-white);
    border-radius: 50%;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(12px) scale(0.8);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease-bounce);
  }

  .pcard:hover .pcard__cta {
    opacity: 1;
    transform: none;
  }

  /* Etiqueta de categoría */
  .pcard__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.38rem 0.85rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--c-white);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }

  /* -------------------------------------------------------------- Texto */

  .pcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.45rem;
    padding: var(--space-md);
  }

  .pcard__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-muted);
    letter-spacing: 0.02em;
  }

  .pcard__dot {
    width: 3px;
    height: 3px;
    background: var(--accent);
    border-radius: 50%;
  }

  .pcard__title {
    font-size: var(--fs-xl);
    transition: color var(--dur) var(--ease);
  }

  .pcard:hover .pcard__title {
    color: var(--accent);
  }

  .pcard__summary {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  .pcard__tags li {
    padding: 0.28rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--accent) 78%, var(--c-ink));
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    border-radius: var(--radius-full);
  }

  .pcard__tags .pcard__more {
    color: var(--c-muted);
    background: var(--c-cream);
  }

  /* --------------------------------------------------------- Tarjeta ancha */

  @media (min-width: 60rem) {
    .pcard--wide {
      grid-column: span 2;
    }

    .pcard--wide .pcard__link {
      flex-direction: row;
    }

    .pcard--wide .pcard__media {
      flex: 1.25;
      aspect-ratio: auto;
      min-height: 22rem;
    }

    .pcard--wide .pcard__body {
      flex: 1;
      justify-content: center;
      padding: var(--space-lg);
    }

    .pcard--wide .pcard__title {
      font-size: var(--fs-2xl);
    }
  }
</style>
