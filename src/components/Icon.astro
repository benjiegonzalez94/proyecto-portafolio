---
/**
 * Icon.astro — Sistema de iconos en SVG.
 *
 * Todos los iconos están dibujados a mano en una retícula de 24×24 y heredan el
 * color del texto (currentColor), así que se adaptan solos a cada contexto.
 *
 * Uso:
 *   <Icon name="instagram" />
 *   <Icon name="arrow-right" size={20} />
 *
 * Lista de nombres disponibles en el objeto `paths` de abajo.
 */
export interface Props {
  name: keyof typeof paths;
  size?: number | string;
  /** Solo para iconos decorativos: si es true, se oculta a los lectores de pantalla. */
  decorative?: boolean;
  class?: string;
}

const paths = {
  // --- Interfaz ---
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5M11 18l-6-6 6-6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'arrow-down': '<path d="M12 5v14M6 13l6 6 6-6"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="3"/><path d="m3 7 8.2 5.5a1.5 1.5 0 0 0 1.6 0L21 7"/>',
  phone:
    '<path d="M6.5 3h-2A1.5 1.5 0 0 0 3 4.6C3 13 11 21 19.4 21a1.5 1.5 0 0 0 1.6-1.5v-2a1.5 1.5 0 0 0-1.2-1.5l-2.6-.5a1.5 1.5 0 0 0-1.5.6l-.8 1a12.6 12.6 0 0 1-5.5-5.5l1-.8a1.5 1.5 0 0 0 .6-1.5l-.5-2.6A1.5 1.5 0 0 0 6.5 3Z"/>',
  'map-pin': '<path d="M12 22s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="11" r="2.6"/>',
  check: '<path d="m4 12.5 5 5L20 6.5"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  send: '<path d="M21 3 3 10.5l7 2.5 2.5 7L21 3Z"/><path d="M21 3 10 14"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  'external-link': '<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>',

  // --- Redes sociales ---
  instagram:
    '<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/>',
  linkedin:
    '<path d="M4.5 9.5v10"/><path d="M10 19.5v-10"/><path d="M10 13.8c0-2.4 1.5-3.9 3.6-3.9s3.9 1.5 3.9 4.2v5.4"/><circle cx="4.5" cy="5" r="1.6"/>',
  behance:
    '<path d="M2.5 5.5h5.8a3 3 0 0 1 0 6H2.5Z"/><path d="M2.5 11.5h6.4a3.2 3.2 0 0 1 0 6.4H2.5Z"/><path d="M14.5 14.2h7a3.5 3.5 0 0 0-7-.6 3.5 3.5 0 0 0 6.4 2.6"/>',
  youtube:
    '<rect x="2" y="5" width="20" height="14" rx="4.5"/><path d="m10 9.2 5 2.8-5 2.8Z" fill="currentColor" stroke="none"/>',
  tiktok:
    '<path d="M14.5 3v10.6a3.9 3.9 0 1 1-3.9-3.9"/><path d="M14.5 5.4a5.6 5.6 0 0 0 4.8 4.4"/>',
  whatsapp:
    '<path d="M3.3 20.7 4.7 16A8.4 8.4 0 1 1 8 19.3Z"/><path d="M8.6 8.3c.3 2.6 2.5 4.8 5.1 5.1.6 0 1.2-.4 1.2-1v-.9l-1.6-.7-.9.9a5 5 0 0 1-2-2l.9-.9-.7-1.6h-.9c-.7 0-1.2.5-1.1 1.1Z"/>',

  // --- Servicios ---
  palette:
    '<path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.7 1.8-1.6 0-.5-.2-.9-.5-1.2a1.6 1.6 0 0 1 1.2-2.7h1.6A4.9 4.9 0 0 0 21 10.6C21 6.4 17 3 12 3Z"/><circle cx="7.6" cy="11.4" r="1.2" fill="currentColor" stroke="none"/><circle cx="11" cy="7.4" r="1.2" fill="currentColor" stroke="none"/><circle cx="15.4" cy="8.6" r="1.2" fill="currentColor" stroke="none"/>',
  video: '<rect x="2.5" y="6" width="13" height="12" rx="3"/><path d="m15.5 11.5 6-3.5v8l-6-3.5Z"/>',
